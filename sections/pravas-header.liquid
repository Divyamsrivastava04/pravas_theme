{% comment %}
  PRAVAS Timepieces — sticky header + mobile off-canvas drawer.
  Rendered sitewide via sections/header-group.json.
{% endcomment %}

<header class="pravas-header" id="pravas-header">
  <div class="pravas-header__inner">

    <div class="pravas-header__left">
      <a href="{{ routes.root_url }}" class="pravas-header__logo-link" aria-label="{{ shop.name | default: 'PRAVAS' }} — home">
        <svg class="pravas-mark pravas-header__mark" viewBox="0 0 60 80" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
          <circle cx="36" cy="30" r="22" stroke="currentColor" stroke-width="2"/>
          <line x1="30" y1="0" x2="30" y2="80" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span class="pravas-header__wordmark">PRAVAS</span>
      </a>
    </div>

    <nav class="pravas-header__nav" aria-label="Primary">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="/pages/our-story">Our Story</a>
      <a href="/pages/philosophy">Philosophy</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="pravas-header__right">
      <a href="{{ routes.cart_url }}" class="pravas-header__cart" id="cart-icon-bubble" aria-label="Cart">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>

      <button
        type="button"
        class="pravas-header__hamburger"
        id="pravas-header-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="pravas-header-drawer"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#F5F3EF" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<div class="pravas-header-drawer" id="pravas-header-drawer" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="pravas-header-drawer__overlay" id="pravas-header-drawer-overlay"></div>
  <div class="pravas-header-drawer__panel">
    <button type="button" class="pravas-header-drawer__close" id="pravas-header-drawer-close" aria-label="Close menu">&#10005;</button>
    <nav class="pravas-header-drawer__nav" aria-label="Mobile">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="/pages/our-story">Our Story</a>
      <a href="/pages/philosophy">Philosophy</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
    </nav>
  </div>
</div>

{% stylesheet %}
  .pravas-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--midnight);
    height: 64px;
  }

  .pravas-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 80px;
    max-width: 1600px;
    margin: 0 auto;
  }

  .pravas-header__left,
  .pravas-header__right {
    display: flex;
    align-items: center;
  }

  .pravas-header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .pravas-header__mark {
    width: auto;
    height: 20px;
    color: var(--parchment);
  }

  .pravas-header__wordmark {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--parchment);
    margin-left: 10px;
    letter-spacing: 1px;
  }

  .pravas-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .pravas-header__nav a {
    font-family: var(--font-body-pravas);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--parchment);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .pravas-header__nav a:hover {
    color: var(--gold);
  }

  .pravas-header__right {
    gap: 20px;
  }

  .pravas-header__cart {
    display: flex;
    align-items: center;
    position: relative;
    color: var(--parchment);
    text-decoration: none;
  }

  .pravas-header__cart .svg-wrapper svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .pravas-header__cart .cart-count-bubble {
    position: absolute;
    top: -6px;
    right: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--midnight);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-pravas);
    font-size: 9px;
    font-weight: 600;
  }

  .pravas-header__hamburger {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
  }

  /* Off-canvas drawer */
  .pravas-header-drawer {
    z-index: 200;
    visibility: hidden;
  }
  .pravas-header-drawer.is-open {
    visibility: visible;
  }

  .pravas-header-drawer__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
    z-index: 199;
  }
  .pravas-header-drawer.is-open .pravas-header-drawer__overlay {
    opacity: 1;
    pointer-events: all;
  }

  .pravas-header-drawer__panel {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    background: var(--midnight);
    transform: translateX(-100%);
    transition: transform 350ms ease;
    z-index: 201;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .pravas-header-drawer.is-open .pravas-header-drawer__panel {
    transform: translateX(0);
  }

  .pravas-header-drawer__close {
    align-self: flex-end;
    background: none;
    border: none;
    color: var(--fog);
    font-size: 18px;
    cursor: pointer;
    padding: 8px;
    margin-bottom: 24px;
  }

  .pravas-header-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pravas-header-drawer__nav a {
    font-family: var(--font-body-pravas);
    font-size: 16px;
    font-weight: 300;
    color: var(--parchment);
    text-decoration: none;
    text-align: left;
  }

  @media (max-width: 767px) {
    .pravas-header {
      height: 56px;
    }
    .pravas-header__inner {
      padding: 0 24px;
    }
    .pravas-header__nav {
      display: none;
    }
    .pravas-header__hamburger {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pravas-header-drawer__overlay,
    .pravas-header-drawer__panel {
      transition: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'pravas-quick-buy.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "PRAVAS Header",
  "settings": [],
  "presets": [
    {
      "name": "PRAVAS Header"
    }
  ]
}
{% endschema %}
