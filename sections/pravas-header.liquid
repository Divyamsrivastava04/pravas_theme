<header class="pw-hdr" id="pw-hdr">
  <div class="pw-hdr__inner">
    <a href="{{ routes.root_url }}" class="pw-hdr__logo">{{ section.settings.brand | default: 'PRAVAS' }}</a>
    <nav class="pw-hdr__nav">
      {% for i in (1..5) %}
        {% assign lbl = 'nav_label_' | append: i %}
        {% assign url = 'nav_url_'   | append: i %}
        {% if section.settings[lbl] != blank %}
          <a href="{{ section.settings[url] | default: '#' }}" class="pw-hdr__link">{{ section.settings[lbl] }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="pw-hdr__right">
      <a href="{{ routes.cart_url }}" class="pw-hdr__cart-link" aria-label="Cart">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {% if cart.item_count > 0 %}<span class="pw-hdr__cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
      <button class="pw-hdr__burger" id="pw-burger" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="pw-nav-drawer" id="pw-nav-drawer">
  <div class="pw-nav-drawer__overlay" id="pw-nav-overlay"></div>
  <div class="pw-nav-drawer__panel">
    <button class="pw-nav-drawer__close" id="pw-nav-close">&#10005;</button>
    {% for i in (1..5) %}
      {% assign lbl = 'nav_label_' | append: i %}
      {% assign url = 'nav_url_'   | append: i %}
      {% if section.settings[lbl] != blank %}
        <a href="{{ section.settings[url] | default: '#' }}" class="pw-nav-drawer__link">{{ section.settings[lbl] }}</a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "PW Header",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "PRAVAS" },
    { "type": "text", "id": "nav_label_1", "label": "Nav 1 text", "default": "Shop" },
    { "type": "url",  "id": "nav_url_1",   "label": "Nav 1 URL" },
    { "type": "text", "id": "nav_label_2", "label": "Nav 2 text", "default": "Our Story" },
    { "type": "url",  "id": "nav_url_2",   "label": "Nav 2 URL" },
    { "type": "text", "id": "nav_label_3", "label": "Nav 3 text", "default": "Philosophy" },
    { "type": "url",  "id": "nav_url_3",   "label": "Nav 3 URL" },
    { "type": "text", "id": "nav_label_4", "label": "Nav 4 text", "default": "FAQ" },
    { "type": "url",  "id": "nav_url_4",   "label": "Nav 4 URL" },
    { "type": "text", "id": "nav_label_5", "label": "Nav 5 text", "default": "Contact" },
    { "type": "url",  "id": "nav_url_5",   "label": "Nav 5 URL" }
  ],
  "presets": [{ "name": "PW Header" }]
}
{% endschema %}
