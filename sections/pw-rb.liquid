{{ 'pravas-collection.css' | asset_url | stylesheet_tag }}
{{ 'pravas-accessory.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Related products / cross-sell for accessories.

  Add it twice: once as a grid ("COMPLETE THE COLLECTION") and once as a
  single feature ("DESIGNED TO ACCOMPANY"), rather than two sections that
  would differ only in layout.

  Products come from Shopify's own recommendations, a chosen collection, or
  one chosen product. Nothing is hardcoded, and the grid reuses the same
  editorial card as the collection page.
{%- endcomment -%}

{%- comment -%}
  Products come from Shopify's recommendations, a chosen collection, or one
  chosen product — never a hardcoded id.

  A single chosen product has nothing to grid, so that source always renders
  as the feature layout, and a feature with nothing chosen falls back to the
  first available product so the section is never half-configured on screen.

  Recommendations arrive through Shopify's own endpoint, so on first render
  there is nothing yet. The product-recommendations element wraps both
  states and global.js swaps in the fetched element's innerHTML, so the
  wrapper has to be emitted either way — which is why that source always
  renders the section even with no content yet.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.product_limit | default: 3
  assign items = nil
  if section.settings.source == 'collection'
    assign items = section.settings.collection.products
  elsif section.settings.source == 'recommendations'
    assign items = recommendations.products
  endif

  assign single = section.settings.product

  assign is_feature = false
  if section.settings.layout == 'feature'
    assign is_feature = true
  endif
  if section.settings.source == 'product'
    assign is_feature = true
  endif

  assign is_reco = false
  if section.settings.source == 'recommendations'
    assign is_reco = true
  endif

  if is_feature and single == blank
    assign single = items.first
  endif

  assign has_content = false
  if is_feature and single != blank
    assign has_content = true
  endif
  if is_feature == false and items.size > 0
    assign has_content = true
  endif

  assign render_section = has_content
  if is_reco
    assign render_section = true
  endif
-%}

{%- if render_section -%}
  <section class="pw-accrel pw-accrel--{{ section.settings.layout }}{% unless has_content %} pw-accrel--pending{% endunless %}" id="pw-accrel-{{ section.id }}">
    {%- if is_reco -%}
      <product-recommendations
        data-url="{{ routes.product_recommendations_url }}?limit={{ limit }}&intent=related"
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
      >
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          {% render 'pravas-accessory-related-body', sec: section, items: recommendations.products, single: single, is_feature: is_feature, limit: limit %}
        {%- endif -%}
      </product-recommendations>
    {%- else -%}
      {% render 'pravas-accessory-related-body', sec: section, items: items, single: single, is_feature: is_feature, limit: limit %}
    {%- endif -%}
  </section>

  <style>
    #pw-accrel-{{ section.id }} {
      --accrel-bg: {{ section.settings.bg_color | default: '#131313' }};
      --accrel-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --accrel-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
      --accrel-accent: {{ section.settings.accent_color | default: '#B5924A' }};
      --accrel-border: {{ section.settings.border_color | default: '#2A2A2A' }};
      --accrel-border-width: {{ section.settings.border_width | default: 1 }}px;

      --accrel-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --accrel-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --accrel-heading-size: {{ section.settings.heading_size | default: 30 }}px;
      --accrel-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 22 }}px;
      --accrel-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;

      --accrel-max-width: {{ section.settings.content_max_width | default: 1280 }}px;
      --accrel-head-gap: {{ section.settings.head_gap | default: 44 }}px;
      --accrel-feature-ratio: {{ section.settings.feature_ratio | default: '16/9' }};
      --accrel-radius: {{ section.settings.radius | default: 0 }}px;

      /* The card itself is the collection page's, so it reads --coll-* */
      --coll-columns: {{ section.settings.columns | default: 3 }};
      --coll-columns-tablet: {{ section.settings.columns_tablet | default: 2 }};
      --coll-columns-mobile: {{ section.settings.columns_mobile | default: 2 }};
      --coll-gap-x: {{ section.settings.grid_gap_x | default: 32 }}px;
      --coll-gap-y: {{ section.settings.grid_gap_y | default: 48 }}px;
      --coll-image-ratio: {{ section.settings.image_ratio | default: '4/5' }};
      --coll-image-fit: {{ section.settings.image_fit | default: 'cover' }};
      --coll-image-bg: {{ section.settings.image_bg_color | default: '#1A1A1A' }};
      --coll-image-radius: {{ section.settings.radius | default: 0 }}px;
      --coll-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
      --coll-accent: {{ section.settings.accent_color | default: '#B5924A' }};
      --coll-border: {{ section.settings.border_color | default: '#2A2A2A' }};
      --coll-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --coll-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --coll-title-size: {{ section.settings.card_title_size | default: 16 }}px;
      --coll-title-size-mobile: {{ section.settings.card_title_size_mobile | default: 14 }}px;
      --coll-price-size: {{ section.settings.card_price_size | default: 13 }}px;
      --coll-desc-size: {{ section.settings.card_desc_size | default: 12 }}px;
      --coll-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;
      --coll-info-offset: {{ section.settings.card_info_offset | default: 16 }}px;
      --coll-info-gap: {{ section.settings.card_info_gap | default: 6 }}px;
      --coll-hover-duration: {{ section.settings.hover_duration | default: 600 }}ms;
      --coll-hover-scale: 1;
      --coll-card-align: {{ section.settings.card_align | default: 'left' }};
      --coll-card-items: {% if section.settings.card_align == 'center' %}center{% else %}flex-start{% endif %};
      --coll-status-bg: #13131300;
      --coll-status-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-status-border: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-radius: {{ section.settings.radius | default: 0 }}px;

      padding-top: {{ section.settings.padding_top | default: 96 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 96 }}px;
      padding-left: {{ section.settings.padding_x | default: 80 }}px;
      padding-right: {{ section.settings.padding_x | default: 80 }}px;
    }
    @media screen and (max-width: 749px) {
      #pw-accrel-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 56 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 56 }}px;
        padding-left: {{ section.settings.padding_x_mobile | default: 20 }}px;
        padding-right: {{ section.settings.padding_x_mobile | default: 20 }}px;
        --coll-gap-x: {{ section.settings.grid_gap_x_mobile | default: 12 }}px;
        --coll-gap-y: {{ section.settings.grid_gap_y_mobile | default: 32 }}px;
      }
    }
  </style>
{%- endif -%}


{% schema %}
{ "name": "PW RB Probe", "settings": [] }
{% endschema %}
