{{ 'pravas-collection.css' | asset_url | stylesheet_tag }}
{{ 'pravas-accessory.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Related products / cross-sell for accessories.

  Add it twice: once as a grid ("COMPLETE THE COLLECTION") and once as a
  single feature ("DESIGNED TO ACCOMPANY"), rather than two sections that
  would differ only in layout.

  Products come from Shopify's own recommendations, a chosen collection, or
  one chosen product. Nothing is hardcoded, and the grid reuses the same
  editorial card as the collection page.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.product_limit | default: 3
  assign items = nil

  case section.settings.source
    when 'collection'
      assign items = section.settings.collection.products
    when 'product'
      assign items = nil
    else
      comment
        Shopify's recommendations are rendered through its own section
        endpoint, which needs the intent and the product id.
      endcomment
      assign items = recommendations.products
  endcase

  assign single = section.settings.product
  assign is_feature = false
  if section.settings.layout == 'feature' or section.settings.source == 'product'
    comment
      A single chosen product has nothing to grid, so that source always
      renders as the feature layout.
    endcomment
    assign is_feature = true
  endif

  comment
    Shopify fetches recommendations through its own endpoint, so on first
    render there is nothing yet. The <product-recommendations> element wraps
    both states and global.js swaps in the fetched element's innerHTML — the
    wrapper has to be present either way, and its data-url must not already
    carry product_id or section_id, which the component appends itself.
  endcomment
  assign is_reco = false
  if section.settings.source == 'recommendations'
    assign is_reco = true
  endif

  comment
    A feature block falls back to the first available product when none has
    been chosen, so the section is never half-configured on screen.
  endcomment
  if is_feature and single == blank
    assign single = items.first
  endif

  assign has_content = false
  if is_feature and single != blank
    assign has_content = true
  elsif is_feature == false and items.size > 0
    assign has_content = true
  endif

  comment
    With recommendations the section must always emit its wrapper so the
    fetch can happen, even though it has nothing to show yet.
  endcomment
  assign render_section = has_content
  if is_reco
    assign render_section = true
  endif
-%}

{%- if render_section -%}
  <section class="pw-accrel pw-accrel--{{ section.settings.layout }}{% unless has_content %} pw-accrel--pending{% endunless %}" id="pw-accrel-{{ section.id }}">
    {%- if is_reco -%}
      <product-recommendations
        data-url="{{ routes.product_recommendations_url }}?limit={{ limit }}&intent=related"
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
      >
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          {% render 'pravas-accessory-related-body', sec: section, items: recommendations.products, single: single, is_feature: is_feature, limit: limit %}
        {%- endif -%}
      </product-recommendations>
    {%- else -%}
      {% render 'pravas-accessory-related-body', sec: section, items: items, single: single, is_feature: is_feature, limit: limit %}
    {%- endif -%}
  </section>

  <style>
    #pw-accrel-{{ section.id }} {
      --accrel-bg: {{ section.settings.bg_color | default: '#131313' }};
      --accrel-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --accrel-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
      --accrel-accent: {{ section.settings.accent_color | default: '#B5924A' }};
      --accrel-border: {{ section.settings.border_color | default: '#2A2A2A' }};
      --accrel-border-width: {{ section.settings.border_width | default: 1 }}px;

      --accrel-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --accrel-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --accrel-heading-size: {{ section.settings.heading_size | default: 30 }}px;
      --accrel-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 22 }}px;
      --accrel-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;

      --accrel-max-width: {{ section.settings.content_max_width | default: 1280 }}px;
      --accrel-head-gap: {{ section.settings.head_gap | default: 44 }}px;
      --accrel-feature-ratio: {{ section.settings.feature_ratio | default: '16/9' }};
      --accrel-radius: {{ section.settings.radius | default: 0 }}px;

      /* The card itself is the collection page's, so it reads --coll-* */
      --coll-columns: {{ section.settings.columns | default: 3 }};
      --coll-columns-tablet: {{ section.settings.columns_tablet | default: 2 }};
      --coll-columns-mobile: {{ section.settings.columns_mobile | default: 2 }};
      --coll-gap-x: {{ section.settings.grid_gap_x | default: 32 }}px;
      --coll-gap-y: {{ section.settings.grid_gap_y | default: 48 }}px;
      --coll-image-ratio: {{ section.settings.image_ratio | default: '4/5' }};
      --coll-image-fit: {{ section.settings.image_fit | default: 'cover' }};
      --coll-image-bg: {{ section.settings.image_bg_color | default: '#1A1A1A' }};
      --coll-image-radius: {{ section.settings.radius | default: 0 }}px;
      --coll-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
      --coll-accent: {{ section.settings.accent_color | default: '#B5924A' }};
      --coll-border: {{ section.settings.border_color | default: '#2A2A2A' }};
      --coll-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --coll-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --coll-title-size: {{ section.settings.card_title_size | default: 16 }}px;
      --coll-title-size-mobile: {{ section.settings.card_title_size_mobile | default: 14 }}px;
      --coll-price-size: {{ section.settings.card_price_size | default: 13 }}px;
      --coll-desc-size: {{ section.settings.card_desc_size | default: 12 }}px;
      --coll-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;
      --coll-info-offset: {{ section.settings.card_info_offset | default: 16 }}px;
      --coll-info-gap: {{ section.settings.card_info_gap | default: 6 }}px;
      --coll-hover-duration: {{ section.settings.hover_duration | default: 600 }}ms;
      --coll-hover-scale: 1;
      --coll-card-align: {{ section.settings.card_align | default: 'left' }};
      --coll-card-items: {% if section.settings.card_align == 'center' %}center{% else %}flex-start{% endif %};
      --coll-status-bg: #13131300;
      --coll-status-text: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-status-border: {{ section.settings.text_color | default: '#F5F3EF' }};
      --coll-radius: {{ section.settings.radius | default: 0 }}px;

      padding-top: {{ section.settings.padding_top | default: 96 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 96 }}px;
      padding-left: {{ section.settings.padding_x | default: 80 }}px;
      padding-right: {{ section.settings.padding_x | default: 80 }}px;
    }
    @media screen and (max-width: 749px) {
      #pw-accrel-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 56 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 56 }}px;
        padding-left: {{ section.settings.padding_x_mobile | default: 20 }}px;
        padding-right: {{ section.settings.padding_x_mobile | default: 20 }}px;
        --coll-gap-x: {{ section.settings.grid_gap_x_mobile | default: 12 }}px;
        --coll-gap-y: {{ section.settings.grid_gap_y_mobile | default: 32 }}px;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "PW Accessory Related",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPLETE THE COLLECTION" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "grid", "label": "Product grid" },
        { "value": "feature", "label": "Single featured product" }
      ], "default": "grid" },
    { "type": "select", "id": "source", "label": "Products from",
      "options": [
        { "value": "recommendations", "label": "Shopify recommendations" },
        { "value": "collection", "label": "A collection" },
        { "value": "product", "label": "One chosen product" }
      ], "default": "recommendations" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "range", "id": "product_limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 3 },

    { "type": "header", "content": "Featured layout" },
    { "type": "text", "id": "feature_eyebrow", "label": "Eyebrow above product name", "default": "A TIMEPIECE, COMPLETED" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "EXPLORE THE TIMEPIECE" },
    { "type": "checkbox", "id": "show_feature_price", "label": "Show price", "default": true },
    { "type": "select", "id": "feature_ratio", "label": "Image ratio",
      "options": [
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/1", "label": "Letterbox (3:1)" }
      ], "default": "16/9" },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "label": "Columns — desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns — tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns — mobile", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "grid_gap_x", "label": "Column gap — desktop", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "grid_gap_y", "label": "Row gap — desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "grid_gap_x_mobile", "label": "Column gap — mobile", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "grid_gap_y_mobile", "label": "Row gap — mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },

    { "type": "header", "content": "Product card" },
    { "type": "select", "id": "image_ratio", "label": "Card image ratio",
      "options": [
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Tall portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ], "default": "4/5" },
    { "type": "select", "id": "image_fit", "label": "Card image fit",
      "options": [
        { "value": "cover", "label": "Fill (crops to the frame)" },
        { "value": "contain", "label": "Fit (whole image, never cropped)" }
      ], "default": "cover" },
    { "type": "color", "id": "image_bg_color", "label": "Card image background", "default": "#1A1A1A" },
    { "type": "select", "id": "card_align", "label": "Card alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ], "default": "left" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show card eyebrow", "default": false },
    { "type": "select", "id": "eyebrow_source", "label": "Card eyebrow source",
      "options": [
        { "value": "type", "label": "Product type" },
        { "value": "vendor", "label": "Vendor" },
        { "value": "collection", "label": "First collection" }
      ], "default": "type" },
    { "type": "checkbox", "id": "show_description", "label": "Show short description", "default": false },
    { "type": "range", "id": "description_words", "label": "Description length", "min": 4, "max": 40, "step": 1, "unit": "wd", "default": 12 },
    { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Swap to second image on hover", "default": true },
    { "type": "checkbox", "id": "show_status", "label": "Show sale / sold out / pre-order", "default": true },
    { "type": "text", "id": "sale_label", "label": "Sale label", "default": "SALE" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "text", "id": "preorder_label", "label": "Pre-order label", "default": "PRE-ORDER" },
    { "type": "range", "id": "card_info_offset", "label": "Space above card info", "min": 0, "max": 48, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_info_gap", "label": "Space between card lines", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 6 },
    { "type": "range", "id": "hover_duration", "label": "Hover transition", "min": 0, "max": 1200, "step": 50, "unit": "ms", "default": 600 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max-width", "min": 700, "max": 1700, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "head_gap", "label": "Space below heading", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 220, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 220, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_x", "label": "Padding sides — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_x_mobile", "label": "Padding sides — mobile", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading — desktop", "min": 14, "max": 60, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading — mobile", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 7, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "card_title_size", "label": "Card title — desktop", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_title_size_mobile", "label": "Card title — mobile", "min": 9, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_price_size", "label": "Card price size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "card_desc_size", "label": "Card description size", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#131313" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F5F3EF" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8A8A8A" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B5924A" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#2A2A2A" },
    { "type": "range", "id": "border_width", "label": "Border thickness", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "PW Accessory Related" }]
}
{% endschema %}
