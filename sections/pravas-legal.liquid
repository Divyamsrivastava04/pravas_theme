{{ 'pravas-legal.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    Content comes straight from the Shopify page — nothing here is
    hardcoded, so the same section serves Terms, Privacy, Shipping and any
    other policy page assigned to this template.

    The table of contents is derived from the H2 headings already present
    in that content. Splitting on '<h2' lets us both collect the headings
    and re-emit each one with an anchor id, without needing JavaScript to
    rewrite the DOM afterwards.
  endcomment
  assign chunks = page.content | split: '<h2'
  assign heading_count = chunks.size | minus: 1

  assign show_toc = false
  if section.settings.show_toc and heading_count >= section.settings.toc_min_headings
    assign show_toc = true
  endif
-%}

<section class="pw-legal{% if show_toc %} pw-legal--with-toc{% endif %}" id="pw-legal-{{ section.id }}">
  <div class="pw-legal__inner">

    <header class="pw-legal__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pw-legal__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="pw-legal__title">{{ page.title | escape }}</h1>
      {%- if section.settings.updated_label != blank and section.settings.updated_value != blank -%}
        <p class="pw-legal__meta">
          <span class="pw-legal__meta-label">{{ section.settings.updated_label }}</span>
          <span class="pw-legal__meta-value">{{ section.settings.updated_value }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.show_rule -%}
        <hr class="pw-legal__rule">
      {%- endif -%}
    </header>

    <div class="pw-legal__body">
      {%- if show_toc -%}
        <nav class="pw-legal__toc" aria-labelledby="pw-legal-toc-title-{{ section.id }}">
          {%- comment -%}
            Rendered open so the contents are visible without JavaScript —
            CSS alone cannot force a <details> open, since the content sits
            in the element's shadow slot. The script collapses it on mobile
            when the setting asks for that.
          {%- endcomment -%}
          <details class="pw-legal__toc-details" open data-pw-legal-toc data-open-mobile="{{ section.settings.toc_open_mobile }}">
            <summary class="pw-legal__toc-summary">
              <span id="pw-legal-toc-title-{{ section.id }}" class="pw-legal__toc-title">{{ section.settings.toc_title }}</span>
              <span class="pw-legal__toc-icon" aria-hidden="true"></span>
            </summary>
            <ol class="pw-legal__toc-list">
              {%- for chunk in chunks offset: 1 -%}
                {%- liquid
                  assign attrs = chunk | split: '>' | first
                  assign rest = chunk | remove_first: attrs
                  assign rest = rest | remove_first: '>'
                  assign head_html = rest | split: '</h2' | first
                  assign head_text = head_html | strip_html | strip
                -%}
                {%- if head_text != blank -%}
                  <li class="pw-legal__toc-item">
                    <a class="pw-legal__toc-link" href="#pw-legal-s{{ forloop.index }}" data-legal-toc="pw-legal-s{{ forloop.index }}">
                      {%- if section.settings.toc_numbered -%}
                        <span class="pw-legal__toc-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                      {%- endif -%}
                      <span class="pw-legal__toc-text">{{ head_text }}</span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </details>
        </nav>
      {%- endif -%}

      {%- liquid
        comment
          Re-emit the content with an anchor id on every H2 so the contents
          links have somewhere to jump to. The heading is assembled as a
          string rather than written as markup, because its closing tag
          arrives inside the chunk and an unbalanced literal <h2> would
          leave the template unparseable.
        endcomment
        if show_toc
          assign rebuilt = chunks[0]
          for chunk in chunks offset: 1
            assign attrs = chunk | split: '>' | first
            assign rest = chunk | remove_first: attrs
            assign rest = rest | remove_first: '>'
            assign open_tag = '<h2 id="pw-legal-s' | append: forloop.index | append: '"' | append: attrs | append: '>'
            assign rebuilt = rebuilt | append: open_tag | append: rest
          endfor
        else
          assign rebuilt = page.content
        endif
      -%}
      {%- comment -%}
        Deliberately not Dawn's .rte class — every element inside is styled
        from the settings below, and .rte would compete with that.
      {%- endcomment -%}
      <div class="pw-legal__content">{{ rebuilt }}</div>
    </div>

  </div>
</section>

<style>
  #pw-legal-{{ section.id }} {
    --legal-bg: {{ section.settings.bg_color | default: '#131313' }};
    --legal-text: {{ section.settings.text_color | default: '#E8E6E1' }};
    --legal-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
    --legal-heading: {{ section.settings.heading_color | default: '#F5F3EF' }};
    --legal-eyebrow: {{ section.settings.eyebrow_color | default: '#B5924A' }};
    --legal-accent: {{ section.settings.accent_color | default: '#B5924A' }};
    --legal-divider: {{ section.settings.divider_color | default: '#2A2A2A' }};
    --legal-divider-width: {{ section.settings.divider_width | default: 1 }}px;
    --legal-radius: {{ section.settings.radius | default: 0 }}px;

    --legal-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --legal-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --legal-title-size: {{ section.settings.title_size | default: 46 }}px;
    --legal-title-size-tablet: {{ section.settings.title_size_tablet | default: 36 }}px;
    --legal-title-size-mobile: {{ section.settings.title_size_mobile | default: 28 }}px;
    --legal-h2-size: {{ section.settings.h2_size | default: 20 }}px;
    --legal-h3-size: {{ section.settings.h3_size | default: 15 }}px;
    --legal-body-size: {{ section.settings.body_size | default: 14 }}px;
    --legal-body-line-height: {{ section.settings.body_line_height | default: 1.9 }};
    --legal-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;
    --legal-eyebrow-spacing: {{ section.settings.eyebrow_letter_spacing | default: 3 }}px;
    --legal-toc-size: {{ section.settings.toc_size | default: 10 }}px;

    --legal-content-width: {{ section.settings.content_max_width | default: 1140 }}px;
    --legal-text-width: {{ section.settings.text_column_width | default: 700 }}px;
    --legal-toc-width: {{ section.settings.toc_width | default: 220 }}px;
    --legal-column-gap: {{ section.settings.column_gap | default: 72 }}px;
    --legal-section-spacing: {{ section.settings.section_spacing | default: 40 }}px;
    --legal-paragraph-spacing: {{ section.settings.paragraph_spacing | default: 18 }}px;
    --legal-head-spacing: {{ section.settings.head_spacing | default: 48 }}px;
    --legal-sticky-offset: {{ section.settings.sticky_offset | default: 90 }}px;

    padding-top: {{ section.settings.padding_top | default: 88 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px;
    padding-left: {{ section.settings.padding_x | default: 40 }}px;
    padding-right: {{ section.settings.padding_x | default: 40 }}px;
  }

  {%- unless section.settings.toc_sticky %}
  #pw-legal-{{ section.id }} .pw-legal__toc-details { position: static; }
  {%- endunless %}

  @media screen and (max-width: 989px) {
    #pw-legal-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 52 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 64 }}px;
      padding-left: {{ section.settings.padding_x_mobile | default: 22 }}px;
      padding-right: {{ section.settings.padding_x_mobile | default: 22 }}px;
    }
    {%- unless section.settings.show_toc_mobile %}
    #pw-legal-{{ section.id }} .pw-legal__toc { display: none; }
    {%- endunless %}
  }
</style>

{%- if section.settings.show_toc -%}
  <script src="{{ 'pravas-legal.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "PW Legal Page",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LEGAL" },
    { "type": "checkbox", "id": "show_rule", "label": "Show divider under header", "default": true },
    { "type": "text", "id": "updated_label", "label": "Metadata label", "info": "Shown only when a value is entered below.", "default": "LAST UPDATED" },
    { "type": "text", "id": "updated_value", "label": "Metadata value", "info": "Enter your own date. Nothing is shown if left blank." },

    { "type": "header", "content": "Contents" },
    { "type": "checkbox", "id": "show_toc", "label": "Show table of contents", "info": "Built automatically from the H2 headings in the page content.", "default": true },
    { "type": "text", "id": "toc_title", "label": "Contents title", "default": "CONTENTS" },
    { "type": "range", "id": "toc_min_headings", "label": "Minimum headings required", "min": 2, "max": 10, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "toc_numbered", "label": "Number the contents", "default": true },
    { "type": "checkbox", "id": "toc_sticky", "label": "Sticky on desktop", "default": true },
    { "type": "checkbox", "id": "show_toc_mobile", "label": "Show on mobile", "default": true },
    { "type": "checkbox", "id": "toc_open_mobile", "label": "Expanded by default on mobile", "default": false },
    { "type": "range", "id": "toc_width", "label": "Contents column width", "min": 160, "max": 340, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "toc_size", "label": "Contents text size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "sticky_offset", "label": "Sticky offset from top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 90 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max-width", "min": 800, "max": 1400, "step": 20, "unit": "px", "default": 1140 },
    { "type": "range", "id": "text_column_width", "label": "Text column width", "min": 480, "max": 900, "step": 10, "unit": "px", "default": 700 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "head_spacing", "label": "Space below header", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_spacing", "label": "Space above each H2", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "paragraph_spacing", "label": "Paragraph spacing", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_x", "label": "Padding sides — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_x_mobile", "label": "Padding sides — mobile", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 22 },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "title_size", "label": "Page title — desktop", "min": 22, "max": 80, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "title_size_tablet", "label": "Page title — tablet", "min": 18, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "title_size_mobile", "label": "Page title — mobile", "min": 16, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "h2_size", "label": "H2 size", "min": 13, "max": 36, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "h3_size", "label": "H3 size", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "body_line_height", "label": "Body line height", "min": 1.2, "max": 2.4, "step": 0.1, "default": 1.9 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 7, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Eyebrow letter spacing", "min": 0, "max": 8, "step": 0.5, "unit": "px", "default": 3 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#131313" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#E8E6E1" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#8A8A8A" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#F5F3EF" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#B5924A" },
    { "type": "color", "id": "accent_color", "label": "Links / accent", "default": "#B5924A" },
    { "type": "color", "id": "divider_color", "label": "Dividers", "default": "#2A2A2A" },
    { "type": "range", "id": "divider_width", "label": "Divider thickness", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "radius", "label": "Corner radius (0 = sharp)", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "PW Legal Page" }]
}
{% endschema %}
