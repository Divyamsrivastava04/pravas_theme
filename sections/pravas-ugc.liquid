<section class="pw-ugc">

  <div class="pw-ugc__head">
    <div class="pw-ugc__head-left">
      <span class="pw-eyebrow pw-ugc__eyebrow">{{ section.settings.eyebrow | default: 'AS SEEN ON' }}</span>
      <h2 class="pw-ugc__h2">{{ section.settings.heading | default: 'The PRAVAS Community' }}</h2>
      <p  class="pw-ugc__sub">{{ section.settings.subtext | default: 'Real wrists. Real moments.' }}</p>
    </div>
    <a href="{{ section.settings.ig_url | default: '#' }}" class="pw-ugc__cta" target="_blank" rel="noopener">
      {{ section.settings.cta | default: 'View All on Instagram @pravas.co →' }}
    </a>
  </div>

  <div class="pw-ugc__grid">
    {% for block in section.blocks %}
      <div class="pw-ugc__card" {{ block.shopify_attributes }}>
        {% if block.settings.thumb %}
          <div class="pw-ugc__thumb-wrap">
            {{ block.settings.thumb | image_url: width: 400 | image_tag:
                 alt: block.settings.handle | default: 'Community',
                 class: 'pw-ugc__thumb',
                 loading: 'lazy',
                 widths: '200,300,400'
            }}
            {% if block.settings.video_url != blank %}
              <button class="pw-ugc__play" data-url="{{ block.settings.video_url }}" aria-label="Play video">&#9658;</button>
            {% endif %}
          </div>
          <div class="pw-ugc__meta">
            {% if block.settings.handle != blank %}
              <span class="pw-ugc__handle">{{ block.settings.handle }}</span>
            {% endif %}
            {% if block.settings.caption != blank %}
              <span class="pw-ugc__caption">{{ block.settings.caption }}</span>
            {% endif %}
          </div>
        {% else %}
          <div class="pw-ugc__ph">
            <span class="pw-ugc__ph-text">{{ section.settings.empty_state_label | default: 'Coming Soon' }}</span>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>

<!-- Lightbox for video -->
<div class="pw-lightbox" id="pw-lightbox" role="dialog" aria-modal="true" style="display:none;">
  <div class="pw-lightbox__overlay" id="pw-lb-overlay"></div>
  <div class="pw-lightbox__wrap">
    <button class="pw-lightbox__close" id="pw-lb-close" aria-label="Close video">&#10005;</button>
    <div class="pw-lightbox__frame" id="pw-lb-frame"></div>
  </div>
</div>

{% schema %}
{
  "name": "PW Community Wall",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",          "default": "AS SEEN ON" },
    { "type": "text", "id": "heading",  "label": "Section heading",  "default": "The PRAVAS Community" },
    { "type": "text", "id": "subtext",  "label": "Subtext",          "default": "Real wrists. Real moments." },
    { "type": "url",  "id": "ig_url",   "label": "Instagram URL" },
    { "type": "text", "id": "cta",      "label": "CTA link text",    "default": "View All on Instagram @pravas.co →" },
    { "type": "text", "id": "empty_state_label", "label": "Empty card placeholder text", "default": "Coming Soon" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo / Video",
      "settings": [
        { "type": "image_picker", "id": "thumb",     "label": "Thumbnail image" },
        { "type": "url",          "id": "video_url", "label": "Video URL (leave blank for photo-only)" },
        { "type": "text",         "id": "handle",    "label": "@handle" },
        { "type": "text",         "id": "caption",   "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PW Community Wall",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
