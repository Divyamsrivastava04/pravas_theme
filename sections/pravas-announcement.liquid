{% if section.settings.enabled %}
<div class="pw-ann" id="pw-ann">
  <div class="pw-ann__track">
    {% assign msgs = section.settings.messages | split: '|' %}
    {% for msg in msgs %}
      <span class="pw-ann__msg" style="animation-delay: {{ forloop.index0 | times: 3 }}s; animation-duration: {{ msgs.size | times: 3 }}s">
        {{ msg | strip }}
      </span>
    {% endfor %}
  </div>
  <button class="pw-ann__close" id="pw-ann-close" aria-label="Dismiss">&#10005;</button>
</div>
{% endif %}

{% schema %}
{
  "name": "PW Announcement Bar",
  "settings": [
    { "type": "checkbox",  "id": "enabled",  "label": "Show bar",    "default": true },
    { "type": "textarea",  "id": "messages", "label": "Messages (separate with | pipe)",
      "default": "AARAMBH IS HERE — 100 PIECES. INDIVIDUALLY NUMBERED.|FREE DELIVERY ACROSS INDIA · AUTOMATIC ONLY · NO QUARTZ|FOUNDER DELIVERY AVAILABLE — PACKED BY HAND, SENT WITH INTENTION|LEATHER STRAPS AVAILABLE — BURGUNDY & BLACK" }
  ],
  "presets": [{ "name": "PW Announcement Bar" }]
}
{% endschema %}
