<section>x</section>
{% schema %}
{
  "name": "TEST-I",
  "settings": [
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "YOUR MESSAGE / INQUIRY"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us how we can assist you…"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button text",
      "default": "SEND INQUIRY"
    },
    {
      "type": "checkbox",
      "id": "submit_show_arrow",
      "label": "Show arrow on button",
      "default": true
    },
    {
      "type": "text",
      "id": "form_note",
      "label": "Note below button",
      "info": "Leave blank to hide. Only state what your store actually offers.",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Our concierge will be in touch shortly."
    },
    {
      "type": "textarea",
      "id": "error_message",
      "label": "Error message",
      "default": "Please check the highlighted field and try again."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max-width",
      "min": 800,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1140
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Form field spacing",
      "min": 6,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "Form panel padding",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding sides — desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding sides — mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Form Panel"
    }
  ]
}
{% endschema %}
