{%- liquid
  comment
    Resolve the product from the picker first, falling back to the handle
    field for existing installs. A handle that no longer matches a product
    silently yields nil, which is what produced "0 of 100 remaining".
  endcomment
  assign prod = section.settings.product
  if prod == blank and section.settings.handle != blank
    assign prod = all_products[section.settings.handle]
  endif

  assign c1_value = section.settings.colourway1_value
  assign c2_value = section.settings.colourway2_value

  assign total = 0
  assign c1_qty = 0
  assign c2_qty = 0
  assign tracked = false

  for v in prod.variants
    if v.inventory_management == 'shopify'
      assign tracked = true
      assign total = total | plus: v.inventory_quantity
      comment
        Variant titles combine every option (e.g. "Sunburst Green / Black"),
        so colourway totals are summed from the option value rather than
        matched against the full title.
      endcomment
      if c1_value != blank and v.option1 == c1_value
        assign c1_qty = c1_qty | plus: v.inventory_quantity
      endif
      if c2_value != blank and v.option1 == c2_value
        assign c2_qty = c2_qty | plus: v.inventory_quantity
      endif
    endif
  endfor

  if total < 0
    assign total = 0
  endif
-%}

<div class="pw-ticker" aria-hidden="true">
  <div class="pw-ticker__inner" id="pw-ticker-inner">
    {%- if section.settings.m1 != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m1 }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}

    {%- comment -%}
      Stock messages only render when inventory is actually tracked, so a
      missing product can never print a misleading count.
    {%- endcomment -%}
    {%- if tracked -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ total }} {{ section.settings.m2_suffix | default: 'of 100 pieces remaining' }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}

    {%- if section.settings.m3 != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m3 }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}
    {%- if section.settings.m4 != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m4 }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}

    {%- if tracked and c1_value != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.colourway1_label | default: 'Sunburst Green:' }} {{ c1_qty }} {{ section.settings.left_suffix | default: 'left' }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}
    {%- if tracked and c2_value != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.colourway2_label | default: 'Midnight Black:' }} {{ c2_qty }} {{ section.settings.left_suffix | default: 'left' }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}

    {%- if section.settings.m7 != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m7 }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}
    {%- if section.settings.m8 != blank -%}
      <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m8 }}</span>
      <span class="pw-ticker__sep">&middot;</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PW Social Proof Ticker",
  "settings": [
    { "type": "header", "content": "Product (for live stock counts)" },
    { "type": "product", "id": "product", "label": "Product", "info": "Stock messages read this product's real inventory. They are hidden entirely if inventory is not tracked in Shopify." },
    { "type": "text", "id": "handle", "label": "Product handle (fallback)", "info": "Only used if no product is selected above." },
    { "type": "text", "id": "colourway1_value", "label": "Colourway 1 — option value", "info": "Must match the product option value exactly, e.g. Sunburst Green.", "default": "Sunburst Green" },
    { "type": "text", "id": "colourway2_value", "label": "Colourway 2 — option value", "default": "Midnight Black" },

    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "m1",     "label": "Message 1",       "default": "Someone just claimed their AARAMBH" },
    { "type": "text", "id": "m2_suffix", "label": "Stock message suffix (after total count)", "default": "of 100 pieces remaining" },
    { "type": "text", "id": "m3",     "label": "Message 3",       "default": "Founder Delivery available — packed by hand" },
    { "type": "text", "id": "m4",     "label": "Message 4",       "default": "Free delivery across India" },
    { "type": "text", "id": "colourway1_label", "label": "Colourway 1 label", "default": "Sunburst Green:" },
    { "type": "text", "id": "colourway2_label", "label": "Colourway 2 label", "default": "Midnight Black:" },
    { "type": "text", "id": "left_suffix", "label": "Inventory suffix", "default": "left" },
    { "type": "text", "id": "m7",     "label": "Message 7",       "default": "Automatic only. No quartz. No compromise." },
    { "type": "text", "id": "m8",     "label": "Message 8",       "default": "Leather straps available — Burgundy & Black" }
  ],
  "presets": [{ "name": "PW Social Proof Ticker" }]
}
{% endschema %}
