{% assign prod    = all_products[section.settings.handle] %}
{% assign v_green = prod.variants | where: 'title', 'Sapphire Green' | first %}
{% assign v_black = prod.variants | where: 'title', 'Midnight Black' | first %}
{% assign total   = v_green.inventory_quantity | plus: v_black.inventory_quantity %}

<div class="pw-ticker" aria-hidden="true">
  <div class="pw-ticker__inner" id="pw-ticker-inner">
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m1 | default: 'Someone just claimed their AARAMBH' }}</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ total | default: '100' }} of 100 pieces remaining</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m3 | default: 'Founder Delivery available — packed by hand' }}</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m4 | default: 'Free delivery across India' }}</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> Sapphire Green: {{ v_green.inventory_quantity | default: '50' }} left</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> Midnight Black: {{ v_black.inventory_quantity | default: '50' }} left</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m7 | default: 'Automatic only. No quartz. No compromise.' }}</span>
    <span class="pw-ticker__sep">&middot;</span>
    <span class="pw-ticker__item"><span class="pw-ticker__dot">&#10022;</span> {{ section.settings.m8 | default: 'Leather straps available — Burgundy & Black' }}</span>
    <span class="pw-ticker__sep">&middot;</span>
  </div>
</div>

{% schema %}
{
  "name": "PW Social Proof Ticker",
  "settings": [
    { "type": "text", "id": "handle", "label": "Product handle",  "default": "pravas-aarambh" },
    { "type": "text", "id": "m1",     "label": "Message 1",       "default": "Someone just claimed their AARAMBH" },
    { "type": "text", "id": "m3",     "label": "Message 3",       "default": "Founder Delivery available — packed by hand" },
    { "type": "text", "id": "m4",     "label": "Message 4",       "default": "Free delivery across India" },
    { "type": "text", "id": "m7",     "label": "Message 7",       "default": "Automatic only. No quartz. No compromise." },
    { "type": "text", "id": "m8",     "label": "Message 8",       "default": "Leather straps available — Burgundy & Black" }
  ],
  "presets": [{ "name": "PW Social Proof Ticker" }]
}
{% endschema %}
