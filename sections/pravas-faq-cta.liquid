{{ 'pravas-faq.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enabled -%}
<section class="pw-faq-cta" id="pw-faq-cta-{{ section.id }}">
  <div class="pw-faq-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="pw-faq-cta__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pw-faq-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="pw-faq-cta__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="pw-faq-cta__btn">
        {{ section.settings.cta_label }}
        {%- if section.settings.cta_show_arrow -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        {%- endif -%}
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pw-faq-cta__meta">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            <span class="pw-faq-cta__meta-item" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'mail' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/></svg>
                {%- when 'phone' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 3h4l2 5-3 2a14 14 0 0 0 6 6l2-3 5 2v4a1 1 0 0 1-1 1A17 17 0 0 1 4 4a1 1 0 0 1 1-1z"/></svg>
                {%- when 'pin' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {%- endcase -%}
              {%- if block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #pw-faq-cta-{{ section.id }} {
    --faq-cta-bg: {{ section.settings.bg_color | default: '#1A1A1A' }};
    --faq-cta-eyebrow: {{ section.settings.eyebrow_color | default: '#B5924A' }};
    --faq-cta-heading: {{ section.settings.heading_color | default: '#F5F3EF' }};
    --faq-cta-body: {{ section.settings.body_color | default: '#8A8A8A' }};
    --faq-cta-meta: {{ section.settings.meta_color | default: '#8A8A8A' }};
    --faq-cta-border: {{ section.settings.border_color | default: '#2A2A2A' }};
    --faq-cta-border-width: {{ section.settings.border_width | default: 0 }}px;
    --faq-cta-radius: {{ section.settings.radius | default: 0 }}px;

    --faq-cta-btn-bg: {{ section.settings.btn_bg_color | default: '#B5924A' }};
    --faq-cta-btn-text: {{ section.settings.btn_text_color | default: '#131313' }};
    --faq-cta-btn-hover-bg: {{ section.settings.btn_hover_bg_color | default: '#C7A25E' }};
    --faq-cta-btn-hover-text: {{ section.settings.btn_hover_text_color | default: '#131313' }};
    --faq-cta-btn-radius: {{ section.settings.btn_radius | default: 0 }}px;
    --faq-cta-btn-padding-y: {{ section.settings.btn_padding_y | default: 14 }}px;
    --faq-cta-btn-padding-x: {{ section.settings.btn_padding_x | default: 30 }}px;
    --faq-cta-btn-size: {{ section.settings.btn_size | default: 10 }}px;
    --faq-cta-btn-spacing: {{ section.settings.btn_letter_spacing | default: 2 }}px;

    --faq-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --faq-cta-heading-size: {{ section.settings.heading_size | default: 34 }}px;
    --faq-cta-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 24 }}px;
    --faq-cta-heading-style: {% if section.settings.heading_italic %}italic{% else %}normal{% endif %};
    --faq-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --faq-cta-body-size: {{ section.settings.body_size | default: 12 }}px;
    --faq-cta-width: {{ section.settings.content_max_width | default: 560 }}px;
    --faq-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;
    --faq-eyebrow-spacing: {{ section.settings.eyebrow_letter_spacing | default: 3 }}px;

    padding-top: {{ section.settings.padding_top | default: 88 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
    padding-left: {{ section.settings.padding_x | default: 40 }}px;
    padding-right: {{ section.settings.padding_x | default: 40 }}px;
  }
  @media screen and (max-width: 749px) {
    #pw-faq-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 56 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 56 }}px;
      padding-left: {{ section.settings.padding_x_mobile | default: 20 }}px;
      padding-right: {{ section.settings.padding_x_mobile | default: 20 }}px;
    }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "PW FAQ CTA",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable section", "default": true },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "STILL CURIOUS?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your journey starts here." },
    { "type": "textarea", "id": "body", "label": "Description", "default": "If you couldn't find what you were looking for, our concierge team is here to help with personal guidance, customisation queries or technical dialogue." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "CONTACT PRAVAS" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "checkbox", "id": "cta_show_arrow", "label": "Show arrow on button", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max-width", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_top", "label": "Padding top — desktop", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom — desktop", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_x", "label": "Padding sides — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top — mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom — mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_x_mobile", "label": "Padding sides — mobile", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 },

    { "type": "header", "content": "Panel" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1A1A1A" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#2A2A2A" },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "radius", "label": "Radius (0 = sharp)", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Button" },
    { "type": "color", "id": "btn_bg_color", "label": "Background", "default": "#B5924A" },
    { "type": "color", "id": "btn_text_color", "label": "Text", "default": "#131313" },
    { "type": "color", "id": "btn_hover_bg_color", "label": "Hover background", "default": "#C7A25E" },
    { "type": "color", "id": "btn_hover_text_color", "label": "Hover text", "default": "#131313" },
    { "type": "range", "id": "btn_radius", "label": "Radius (0 = sharp)", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "btn_padding_y", "label": "Vertical padding", "min": 6, "max": 30, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "btn_padding_x", "label": "Horizontal padding", "min": 8, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "btn_size", "label": "Font size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "btn_letter_spacing", "label": "Letter spacing", "min": 0, "max": 6, "step": 0.5, "unit": "px", "default": 2 },

    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size — desktop", "min": 18, "max": 64, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 14, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "heading_italic", "label": "Italic heading", "default": true },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 7, "max": 16, "step": 1, "unit": "px", "default": 9 },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Eyebrow letter spacing", "min": 0, "max": 8, "step": 0.5, "unit": "px", "default": 3 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#B5924A" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#F5F3EF" },
    { "type": "color", "id": "body_color", "label": "Description", "default": "#8A8A8A" },
    { "type": "color", "id": "meta_color", "label": "Contact details", "default": "#8A8A8A" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact Detail",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "clock", "label": "Clock" }, { "value": "mail", "label": "Email" }, { "value": "phone", "label": "Phone" }, { "value": "pin", "label": "Location" }], "default": "clock" },
        { "type": "text", "id": "text", "label": "Text", "default": "Mon–Sat, 10:00–19:00 IST" },
        { "type": "url", "id": "link_url", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW FAQ CTA",
      "blocks": [
        { "type": "detail", "settings": { "icon": "clock", "text": "Mon–Sat, 10:00–19:00 IST" } },
        { "type": "detail", "settings": { "icon": "mail", "text": "concierge@pravas.in" } }
      ]
    }
  ]
}
{% endschema %}
