{% comment %}
  PRAVAS Timepieces — brand pillars. Typographic only — no icons.
  Background is always light parchment (#F5F3EF), never dark.
{% endcomment %}

<div class="pravas-section pravas-pillars-section">
  <p class="pravas-eyebrow pravas-eyebrow--fog pravas-pillars__eyebrow">WHAT WE STAND FOR</p>

  <div class="pravas-pillars__grid">

    <div class="pravas-pillar">
      <h3 class="pravas-pillar__heading">Automatic Only</h3>
      <p class="pravas-pillar__body">No quartz. No compromise. Every PRAVAS watch carries a self-winding movement — a small engine that runs on the energy of your day.</p>
    </div>

    <div class="pravas-pillar-divider"></div>

    <div class="pravas-pillar">
      <h3 class="pravas-pillar__heading">Designed in India</h3>
      <p class="pravas-pillar__body">Every detail — the dial geometry, the case proportions, the hands — is considered here, for the Indian wrist and the Indian story.</p>
    </div>

    <div class="pravas-pillar-divider"></div>

    <div class="pravas-pillar">
      <h3 class="pravas-pillar__heading">Built for First Milestones</h3>
      <p class="pravas-pillar__body">The first job. The first risk. The first city. PRAVAS marks the moments that define who you are becoming.</p>
    </div>

  </div>
</div>

{% stylesheet %}
  .pravas-pillars-section {
    background: var(--parchment);
    padding: 100px 80px;
  }

  .pravas-pillars__eyebrow {
    text-align: center;
    margin-bottom: 48px;
  }

  .pravas-pillars__grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr;
    gap: 0 40px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .pravas-pillar {
    padding: 0 20px;
  }

  .pravas-pillar-divider {
    width: 1px;
    background: var(--gold);
    align-self: stretch;
  }

  .pravas-pillar__heading {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--midnight);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .pravas-pillar__body {
    font-family: var(--font-body-pravas);
    font-size: 14px;
    font-weight: 300;
    color: var(--charcoal);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 767px) {
    .pravas-pillars-section {
      padding: 60px 24px;
    }
    .pravas-pillars__grid {
      grid-template-columns: 1fr;
      gap: 40px 0;
    }
    .pravas-pillar-divider {
      display: none;
    }
    .pravas-pillar {
      padding: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PRAVAS Brand Pillars",
  "settings": [],
  "presets": [
    {
      "name": "PRAVAS Brand Pillars"
    }
  ]
}
{% endschema %}
