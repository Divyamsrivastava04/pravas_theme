{% stylesheet %}
  .pravas-trust-section {
    background: var(--midnight);
    padding: 80px;
  }

  .pravas-trust__eyebrow {
    text-align: center;
    margin-bottom: 48px;
  }

  .pravas-trust__grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr 1px 1fr;
    gap: 0 32px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  .pravas-trust-divider {
    width: 1px;
    background: var(--gold);
    align-self: stretch;
    min-height: 120px;
  }

  .pravas-trust__item {
    text-align: center;
    padding: 0 12px;
  }

  .pravas-trust__icon {
    width: 32px;
    height: 32px;
    margin: 0 auto 16px;
    display: block;
  }

  .pravas-trust__heading {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    color: var(--parchment);
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .pravas-trust__sub {
    font-family: var(--font-body-pravas);
    font-size: 11px;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .pravas-trust__body {
    font-family: var(--font-body-pravas);
    font-size: 13px;
    font-weight: 300;
    color: var(--silver-mist);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 767px) {
    .pravas-trust-section {
      padding: 60px 24px;
    }
    .pravas-trust__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }
    .pravas-trust-divider {
      display: none;
    }
  }
{% endstylesheet %}

