<section class="pw-trust">
  <span class="pw-eyebrow pw-trust__eyebrow">{{ section.settings.eyebrow | default: 'WHY PRAVAS' }}</span>
  <div class="pw-trust__grid">

    <div class="pw-trust__item">
      {% if section.settings.icon1 %}
        <img src="{{ section.settings.icon1 | image_url: width: 48 }}" alt="" class="pw-trust__icon" loading="lazy" width="32" height="32">
      {% endif %}
      <h4 class="pw-trust__h">{{ section.settings.h1 | default: 'Japanese Movement' }}</h4>
      <p  class="pw-trust__sub">{{ section.settings.s1 | default: 'Miyota 8215' }}</p>
      <p  class="pw-trust__p">{{ section.settings.p1 | default: 'Miyota 8215 automatic — reliable, serviceable, honest.' }}</p>
    </div>

    <div class="pw-trust__div" aria-hidden="true"></div>

    <div class="pw-trust__item">
      {% if section.settings.icon2 %}
        <img src="{{ section.settings.icon2 | image_url: width: 48 }}" alt="" class="pw-trust__icon" loading="lazy" width="32" height="32">
      {% endif %}
      <h4 class="pw-trust__h">{{ section.settings.h2 | default: 'Sapphire Crystal' }}</h4>
      <p  class="pw-trust__sub">{{ section.settings.s2 | default: 'Scratch Resistant' }}</p>
      <p  class="pw-trust__p">{{ section.settings.p2 | default: 'Scratch-resistant sapphire on the front. No compromises on the face of the watch.' }}</p>
    </div>

    <div class="pw-trust__div" aria-hidden="true"></div>

    <div class="pw-trust__item">
      {% if section.settings.icon3 %}
        <img src="{{ section.settings.icon3 | image_url: width: 48 }}" alt="" class="pw-trust__icon" loading="lazy" width="32" height="32">
      {% endif %}
      <h4 class="pw-trust__h">{{ section.settings.h3 | default: 'Limited Production' }}</h4>
      <p  class="pw-trust__sub">{{ section.settings.s3 | default: '100 Pieces Total' }}</p>
      <p  class="pw-trust__p">{{ section.settings.p3 | default: 'Each collection is capped. Your number is yours.' }}</p>
    </div>

    <div class="pw-trust__div" aria-hidden="true"></div>

    <div class="pw-trust__item">
      {% if section.settings.icon4 %}
        <img src="{{ section.settings.icon4 | image_url: width: 48 }}" alt="" class="pw-trust__icon" loading="lazy" width="32" height="32">
      {% endif %}
      <h4 class="pw-trust__h">{{ section.settings.h4 | default: 'Transparent Pricing' }}</h4>
      <p  class="pw-trust__sub">{{ section.settings.s4 | default: '₹8,499 — One Price' }}</p>
      <p  class="pw-trust__p">{{ section.settings.p4 | default: 'One honest price. No hidden costs, no inflated MRPs.' }}</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "PW Trust Indicators",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Section eyebrow", "default": "WHY PRAVAS" },
    { "type": "header", "content": "Column 1 — Japanese Movement" },
    { "type": "image_picker", "id": "icon1", "label": "Icon image" },
    { "type": "text",     "id": "h1", "label": "Heading",    "default": "Japanese Movement" },
    { "type": "text",     "id": "s1", "label": "Sub-label",  "default": "Miyota 8215" },
    { "type": "textarea", "id": "p1", "label": "Body copy",  "default": "Miyota 8215 automatic — reliable, serviceable, honest." },
    { "type": "header", "content": "Column 2 — Sapphire Crystal" },
    { "type": "image_picker", "id": "icon2", "label": "Icon image" },
    { "type": "text",     "id": "h2", "label": "Heading",    "default": "Sapphire Crystal" },
    { "type": "text",     "id": "s2", "label": "Sub-label",  "default": "Scratch Resistant" },
    { "type": "textarea", "id": "p2", "label": "Body copy",  "default": "Scratch-resistant sapphire on the front. No compromises on the face of the watch." },
    { "type": "header", "content": "Column 3 — Limited Production" },
    { "type": "image_picker", "id": "icon3", "label": "Icon image" },
    { "type": "text",     "id": "h3", "label": "Heading",    "default": "Limited Production" },
    { "type": "text",     "id": "s3", "label": "Sub-label",  "default": "100 Pieces Total" },
    { "type": "textarea", "id": "p3", "label": "Body copy",  "default": "Each collection is capped. Your number is yours." },
    { "type": "header", "content": "Column 4 — Transparent Pricing" },
    { "type": "image_picker", "id": "icon4", "label": "Icon image" },
    { "type": "text",     "id": "h4", "label": "Heading",    "default": "Transparent Pricing" },
    { "type": "text",     "id": "s4", "label": "Sub-label",  "default": "₹8,499 — One Price" },
    { "type": "textarea", "id": "p4", "label": "Body copy",  "default": "One honest price. No hidden costs, no inflated MRPs." }
  ],
  "presets": [{ "name": "PW Trust Indicators" }]
}
{% endschema %}
