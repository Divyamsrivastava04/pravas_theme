{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
  assign media = product.media
-%}

{{ 'pravas-product.css' | asset_url | stylesheet_tag }}

<section class="pw-pdp" id="pw-pdp" data-section-id="{{ section.id }}">
  <div class="pw-pdp__inner">

    <!-- GALLERY -->
    <div class="pw-pdp__gallery" id="pw-pdp-gallery">
      <div class="pw-pdp__gallery-main">
        {%- if media.size > 0 -%}
          {%- for m in media -%}
            {%- liquid
              assign media_alt = m.alt | default: product.title
              assign media_loading = 'lazy'
              if forloop.first
                assign media_loading = 'eager'
              endif
            -%}
            <div class="pw-pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ m.id }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m | media_tag }}
              {%- else -%}
                {{ m | image_url: width: 1400 | image_tag: alt: media_alt, class: 'pw-pdp__gallery-img', loading: media_loading, widths: '700,1000,1400' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="pw-pdp__gallery-ph">No product image</div>
        {%- endif -%}
        {% if section.settings.enable_zoom %}
          <button type="button" class="pw-pdp__zoom-btn" id="pw-pdp-zoom-btn" aria-label="View full screen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        {% endif %}
      </div>

      {%- if media.size > 1 -%}
        <div class="pw-pdp__gallery-grid">
          {%- for m in media -%}
            {%- assign thumb_alt = m.alt | default: product.title -%}
            <button type="button" class="pw-pdp__gallery-thumb{% if forloop.first %} is-active{% endif %}" data-media-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m.preview_image | image_url: width: 600 | image_tag: alt: thumb_alt, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy', widths: '200,400,600' }}
              {%- else -%}
                {{ m | image_url: width: 600 | image_tag: alt: thumb_alt, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy', widths: '200,400,600' }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO PANEL -->
    <div class="pw-pdp__info">
      <span class="pw-pdp__eyebrow">{{ section.settings.eyebrow | default: 'THE FIRST CHAPTER' }}</span>
      <h1 class="pw-pdp__title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="pw-pdp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pw-pdp__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="pw-pdp__feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon -%}
                  <img src="{{ block.settings.icon | image_url: width: 48 }}" alt="" class="pw-pdp__feature-icon" loading="lazy" width="20" height="20">
                {%- else -%}
                  <svg class="pw-pdp__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endif -%}
                <span class="pw-pdp__feature-label">{{ block.settings.label }}</span>
                {%- if block.settings.value != blank -%}<span class="pw-pdp__feature-value">{{ block.settings.value }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'pw-pdp-form', class: 'pw-pdp__form' -%}
        <input type="hidden" name="id" id="pw-pdp-variant-id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            {%- liquid
              comment
                Automatic picks the style for the whole row, not per swatch:
                one value without a picture would otherwise sit as a small
                colour block beside tall image tiles. If anything in the row
                has an image, the row goes image style and the rest fill
                their tile with their colour.
              endcomment
              assign row_mode = 'color'
              if section.settings.swatch_mode == 'image'
                assign row_mode = 'image'
              elsif section.settings.swatch_mode == 'auto'
                for value in option.values
                  assign scan_key = value | downcase | strip
                  for sb in section.blocks
                    if sb.type == 'swatch_color'
                      assign sb_key = sb.settings.option_value | downcase | strip
                      if sb_key == scan_key and sb.settings.image != blank
                        assign row_mode = 'image'
                      endif
                    endif
                  endfor
                  if value.swatch.image
                    assign row_mode = 'image'
                  endif
                  if section.settings.swatch_use_variant_image
                    for v in product.variants
                      if v.options[option_index] == value and v.image
                        assign row_mode = 'image'
                        break
                      endif
                    endfor
                  endif
                endfor
              endif
            -%}
            <div class="pw-pdp__option" data-option-index="{{ option_index }}">
              <span class="pw-pdp__option-label">
                {{ option.name }}: <span class="pw-pdp__option-selected" data-option-selected>{{ option.selected_value }}</span>
              </span>
              <div class="pw-pdp__swatches">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_bg = ''
                    assign swatch_fg = ''
                    assign swatch_img = ''
                    assign swatch_href = ''
                    assign swatch_attrs = ''
                    assign value_key = value | downcase | strip

                    comment
                      A Swatch Colour block matching this value supplies the
                      colour, an image and — when set — a link to another
                      product, which turns the swatch into navigation rather
                      than a variant selector.
                    endcomment
                    for sb in section.blocks
                      if sb.type == 'swatch_color'
                        assign sb_key = sb.settings.option_value | downcase | strip
                        if sb_key != '' and sb_key == value_key
                          assign swatch_bg = sb.settings.color
                          assign swatch_fg = sb.settings.text_color
                          assign swatch_img = sb.settings.image
                          assign swatch_href = sb.settings.link_url
                          if sb.settings.link_product != blank
                            assign swatch_href = sb.settings.link_product.url
                          endif
                          assign swatch_attrs = sb.shopify_attributes
                        endif
                      endif
                    endfor

                    comment
                      Fall back to Shopify's own swatch metafield, then to the
                      photo of the first variant carrying this value, so a
                      product with variant images needs no setup at all.
                    endcomment
                    if swatch_bg == blank and value.swatch.color
                      assign swatch_bg = value.swatch.color
                    endif
                    if swatch_img == blank and value.swatch.image
                      assign swatch_img = value.swatch.image
                    endif
                    if swatch_img == blank and section.settings.swatch_use_variant_image
                      for v in product.variants
                        if v.options[option_index] == value and v.image
                          assign swatch_img = v.image
                          break
                        endif
                      endfor
                    endif

                    assign swatch_active = false
                    if value == option.selected_value
                      assign swatch_active = true
                    endif
                  -%}
                  {%- render 'pravas-product-swatch',
                    label: value,
                    image: swatch_img,
                    color: swatch_bg,
                    text_color: swatch_fg,
                    href: swatch_href,
                    option_index: option_index,
                    is_active: swatch_active,
                    mode: row_mode,
                    attrs: swatch_attrs
                  -%}
                {%- endfor -%}

                {%- comment -%}
                  Swatch Link blocks add colours that live on a separate
                  product. They are never a selectable variant here, so they
                  only render when they carry a destination.
                {%- endcomment -%}
                {%- for sb in section.blocks -%}
                  {%- if sb.type == 'swatch_link' -%}
                    {%- liquid
                      assign target = sb.settings.option_name | downcase | strip
                      assign this_option = option.name | downcase | strip
                      assign in_this_row = false
                      if target == this_option
                        assign in_this_row = true
                      elsif target == '' and option_index == 0
                        assign in_this_row = true
                      endif

                      assign link_href = sb.settings.link_url
                      if sb.settings.link_product != blank
                        assign link_href = sb.settings.link_product.url
                      endif

                      assign link_label = sb.settings.label
                      if link_label == blank
                        assign link_label = sb.settings.link_product.title
                      endif

                      assign link_image = sb.settings.image
                      if link_image == blank and section.settings.swatch_use_variant_image
                        assign link_image = sb.settings.link_product.featured_image
                      endif
                    -%}
                    {%- if in_this_row and link_href != blank -%}
                      {%- render 'pravas-product-swatch',
                        label: link_label,
                        image: link_image,
                        color: sb.settings.color,
                        text_color: sb.settings.text_color,
                        href: link_href,
                        option_index: option_index,
                        is_active: false,
                        mode: row_mode,
                        attrs: sb.shopify_attributes
                      -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {%- liquid
          comment
            A Swatch Link whose option row does not exist on this product had
            nowhere to render — and a product down to a single variant has no
            option rows at all, so every link block vanished. Those orphans
            now get a row of their own, which is what makes a cross-product
            colour selector work on both sides even when the two products are
            built differently.
          endcomment
          assign option_names = '|'
          unless product.has_only_default_variant
            for opt in product.options_with_values
              assign opt_key = opt.name | downcase | strip
              assign option_names = option_names | append: opt_key | append: '|'
            endfor
          endunless

          assign has_orphan_links = false
          for sb in section.blocks
            if sb.type == 'swatch_link'
              assign sb_href = sb.settings.link_url
              if sb.settings.link_product != blank
                assign sb_href = sb.settings.link_product.url
              endif
              if sb_href != blank
                assign t = sb.settings.option_name | downcase | strip
                assign matched = false
                if t == blank
                  unless product.has_only_default_variant
                    assign matched = true
                  endunless
                else
                  assign needle = '|' | append: t | append: '|'
                  if option_names contains needle
                    assign matched = true
                  endif
                endif
                if matched == false
                  assign has_orphan_links = true
                endif
              endif
            endif
          endfor
        -%}

        {%- if has_orphan_links -%}
          <div class="pw-pdp__option pw-pdp__option--links">
            {%- if section.settings.link_row_label != blank -%}
              <span class="pw-pdp__option-label">
                {{ section.settings.link_row_label }}{% if section.settings.link_row_show_current %}: <span class="pw-pdp__option-selected">{{ section.settings.link_row_current_label | default: product.title }}</span>{% endif %}
              </span>
            {%- endif -%}
            <div class="pw-pdp__swatches">
              {%- if section.settings.link_row_show_current -%}
                {%- comment -%}
                  The product being viewed, shown as the active choice. It is
                  a link to itself so the variant picker's script leaves it
                  alone — it selects nothing on this page.
                {%- endcomment -%}
                {%- render 'pravas-product-swatch',
                  label: section.settings.link_row_current_label | default: product.title,
                  image: product.featured_image,
                  color: section.settings.link_row_current_color,
                  text_color: section.settings.link_row_current_text_color,
                  href: product.url,
                  option_index: 'links',
                  is_active: true,
                  mode: section.settings.swatch_mode
                -%}
              {%- endif -%}

              {%- for sb in section.blocks -%}
                {%- if sb.type == 'swatch_link' -%}
                  {%- liquid
                    assign link_href = sb.settings.link_url
                    if sb.settings.link_product != blank
                      assign link_href = sb.settings.link_product.url
                    endif

                    assign t = sb.settings.option_name | downcase | strip
                    assign matched = false
                    if t == blank
                      unless product.has_only_default_variant
                        assign matched = true
                      endunless
                    else
                      assign needle = '|' | append: t | append: '|'
                      if option_names contains needle
                        assign matched = true
                      endif
                    endif

                    assign link_label = sb.settings.label
                    if link_label == blank
                      assign link_label = sb.settings.link_product.title
                    endif

                    assign link_image = sb.settings.image
                    if link_image == blank and section.settings.swatch_use_variant_image
                      assign link_image = sb.settings.link_product.featured_image
                    endif
                  -%}
                  {%- if matched == false and link_href != blank -%}
                    {%- render 'pravas-product-swatch',
                      label: link_label,
                      image: link_image,
                      color: sb.settings.color,
                      text_color: sb.settings.text_color,
                      href: link_href,
                      option_index: 'links',
                      is_active: false,
                      mode: section.settings.swatch_mode,
                      attrs: sb.shopify_attributes
                    -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="pw-pdp__availability" id="pw-pdp-availability" data-threshold="{{ section.settings.low_stock_threshold | default: 15 }}">
          {%- if current_variant.inventory_management == 'shopify' -%}
            <span class="pw-pdp__availability-label">{{ section.settings.availability_label | default: 'FIRST BATCH AVAILABILITY' }}</span>
            <span class="pw-pdp__availability-count" id="pw-pdp-availability-count">{{ current_variant.inventory_quantity }} {{ section.settings.units_left_label | default: 'UNITS LEFT' }}</span>
          {%- endif -%}
        </div>

        <div class="pw-pdp__price" id="pw-pdp-price">
          <span class="pw-pdp__price-current" id="pw-pdp-price-current">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare" hidden></span>
          {%- endif -%}
        </div>

        {%- liquid
          comment
            Optional accessory add-on. The accessory stays its own Shopify
            product: nothing here alters the watch's price or variants, and
            adding it produces a second, independent cart line. If no
            accessory product is chosen the whole block is absent, so the
            page behaves exactly as it did before.
          endcomment
          assign addon = section.settings.accessory_product
          assign show_addon = false
          if section.settings.show_accessory and addon != blank and addon.variants.size > 0
            assign show_addon = true
          endif

          assign addon_first = nil
          for v in addon.variants
            if v.available
              assign addon_first = v
              break
            endif
          endfor
        -%}

        {%- comment -%}
          Hidden on the storefront when no accessory product is chosen, but
          silent absence is indistinguishable from a bug, so the theme
          editor gets a reason instead of nothing. request.design_mode is
          only ever true inside the editor.
        {%- endcomment -%}
        {%- if section.settings.show_accessory and addon == blank and request.design_mode -%}
          <p class="pw-addon__setup">
            Pick an <strong>Accessory product</strong> under “Optional accessory” in this section’s settings to show the add-on block here. Nothing is shown to customers until you do.
          </p>
        {%- endif -%}

        {%- if show_addon -%}
          <div class="pw-addon" id="pw-addon" data-addon-product-url="{{ addon.url }}">
            {%- if section.settings.accessory_heading != blank -%}
              <span class="pw-addon__eyebrow">{{ section.settings.accessory_heading }}</span>
            {%- endif -%}

            <div class="pw-addon__card">
              {%- if section.settings.accessory_show_image -%}
                {%- liquid
                  assign addon_img = addon_first.image | default: addon.featured_image
                  assign addon_alt = addon_img.alt | default: addon.title
                -%}
                <span class="pw-addon__media">
                  {%- if addon_img -%}
                    {{
                      addon_img
                      | image_url: width: 400
                      | image_tag:
                        alt: addon_alt,
                        class: 'pw-addon__img',
                        id: 'pw-addon-img',
                        loading: 'lazy',
                        widths: '100,160,220,300,400'
                    }}
                  {%- endif -%}
                </span>
              {%- endif -%}

              <div class="pw-addon__body">
                <a class="pw-addon__title" href="{{ addon.url }}">{{ addon.title }}</a>

                {%- if section.settings.accessory_show_price -%}
                  <span class="pw-addon__price" id="pw-addon-price">+ {{ addon_first.price | default: addon.price | money }}</span>
                {%- endif -%}

                {%- if addon.variants.size > 1 -%}
                  <div class="pw-addon__opts" role="group" aria-label="{{ addon.title | escape }}">
                    {%- for v in addon.variants -%}
                      {%- liquid
                        assign v_img = v.image | default: addon.featured_image
                        assign v_src = ''
                        if v_img
                          assign v_src = v_img | image_url: width: 400
                        endif
                        assign is_first_available = false
                        if addon_first != nil and v.id == addon_first.id
                          assign is_first_available = true
                        endif
                      -%}
                      <button
                        type="button"
                        class="pw-addon__opt{% if is_first_available %} is-active{% endif %}"
                        data-addon-variant="{{ v.id }}"
                        data-addon-price="{{ v.price }}"
                        data-addon-title="{{ v.title | escape }}"
                        data-addon-image="{{ v_src }}"
                        {% unless v.available %}disabled aria-disabled="true"{% endunless %}
                      >
                        <span class="pw-addon__opt-label">{{ v.title }}</span>
                        {%- unless v.available -%}
                          <span class="pw-addon__opt-state">{{ section.settings.accessory_sold_out_label | default: 'SOLD OUT' }}</span>
                        {%- endunless -%}
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- comment -%}
                  The toggle is what actually puts the accessory in the order.
                  It is disabled outright when nothing in the accessory is in
                  stock, so a sold-out strap can never be added while the
                  watch itself stays purchasable.
                {%- endcomment -%}
                <button
                  type="button"
                  class="pw-addon__toggle"
                  id="pw-addon-toggle"
                  aria-pressed="false"
                  data-add-label="{{ section.settings.accessory_add_label | default: '+ ADD STRAP' | escape }}"
                  data-added-label="{{ section.settings.accessory_added_label | default: 'STRAP ADDED — REMOVE' | escape }}"
                  {% if addon_first == nil %}disabled{% endif %}
                >
                  {%- if addon_first == nil -%}
                    {{ section.settings.accessory_sold_out_label | default: 'SOLD OUT' }}
                  {%- else -%}
                    {{ section.settings.accessory_add_label | default: '+ ADD STRAP' }}
                  {%- endif -%}
                </button>
              </div>
            </div>

            {%- if section.settings.accessory_note != blank -%}
              <p class="pw-addon__note">{{ section.settings.accessory_note }}</p>
            {%- endif -%}
          </div>

          <script type="application/json" id="pw-addon-variants-json">
            {{ addon.variants | json }}
          </script>
        {%- endif -%}

        {%- if section.settings.show_price_summary -%}
          <div class="pw-sum" id="pw-sum">
            <div class="pw-sum__row">
              <span class="pw-sum__label">{{ section.settings.summary_product_label | default: 'WATCH' }}</span>
              <span class="pw-sum__value" id="pw-sum-product">{{ current_variant.price | money }}</span>
            </div>
            <div class="pw-sum__row" id="pw-sum-addon-row" hidden>
              <span class="pw-sum__label" id="pw-sum-addon-label">{{ addon.title | default: 'ACCESSORY' }}</span>
              <span class="pw-sum__value" id="pw-sum-addon"></span>
            </div>
            <div class="pw-sum__row pw-sum__row--total">
              <span class="pw-sum__label">{{ section.settings.summary_total_label | default: 'TOTAL' }}</span>
              <span class="pw-sum__value" id="pw-sum-total">{{ current_variant.price | money }}</span>
            </div>
          </div>
        {%- endif -%}

        <button
          type="submit"
          name="add"
          class="pw-pdp__atc"
          id="pw-pdp-atc"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="pw-pdp__atc-text">
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
            {%- else -%}
              {{ section.settings.sold_out_label | default: 'SOLD OUT' }}
            {%- endif -%}
          </span>
        </button>

        {%- if section.settings.reassurance != blank -%}
          <p class="pw-pdp__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>

  <!-- Full variant data for client-side switching (real Shopify data, no hardcoding) -->
  <script type="application/json" id="pw-pdp-variants-json">
    {{ product.variants | json }}
  </script>
  <script type="application/json" id="pw-pdp-media-json">
    [{% for m in media %}{"id":{{ m.id | json }},"index":{{ forloop.index0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>
  <script>window.pravasMoneyFormat = {{ shop.money_format | json }};</script>
</section>

<!-- STICKY ADD-TO-CART BAR -->
{% if section.settings.enable_sticky_bar %}
  <div class="pw-pdp-sticky" id="pw-pdp-sticky">
    <div class="pw-pdp-sticky__inner">
      <div class="pw-pdp-sticky__info">
        <span class="pw-pdp-sticky__eyebrow">{{ section.settings.sticky_eyebrow | default: 'CURRENTLY VIEWING' }}</span>
        <span class="pw-pdp-sticky__title">{{ product.title }} <span id="pw-pdp-sticky-variant">{% unless product.has_only_default_variant %}— {{ current_variant.title }}{% endunless %}</span></span>
      </div>
      <span class="pw-pdp-sticky__price" id="pw-pdp-sticky-price">{{ current_variant.price | money }}</span>
      <button type="button" class="pw-pdp-sticky__btn" id="pw-pdp-sticky-atc">
        {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
      </button>
    </div>
  </div>
{% endif %}

<style>
  #pw-pdp, #pw-pdp-sticky {
    --product-page-bg: {{ section.settings.color_bg | default: '#181818' }};
    --product-text: {{ section.settings.color_text | default: '#F5F3EF' }};
    --product-muted: {{ section.settings.color_muted | default: '#888888' }};
    --product-accent: {{ section.settings.color_accent | default: '#B5924A' }};
    --product-border: {{ section.settings.color_border | default: '#2E2E2E' }};

    --product-panel-bg: {{ section.settings.color_panel_bg | default: '#F5F3EF' }};
    --product-panel-text: {{ section.settings.color_panel_text | default: '#181818' }};
    --product-panel-muted: {{ section.settings.color_panel_muted | default: '#3A3A3A' }};

    --product-heading-font: var(--font-display);
    --product-heading-size: {{ section.settings.title_size_desktop | default: 40 }}px;
    --product-heading-size-mobile: {{ section.settings.title_size_mobile | default: 30 }}px;
    --product-heading-weight: {{ section.settings.title_weight | default: '400' }};
    --product-heading-line-height: {{ section.settings.title_line_height | default: 1.1 }};

    --product-eyebrow-color: {{ section.settings.color_eyebrow | default: '#B5924A' }};

    --product-button-bg: {{ section.settings.atc_bg | default: '#B5924A' }};
    --product-button-text: {{ section.settings.atc_text_color | default: '#181818' }};
