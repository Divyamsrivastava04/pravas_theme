{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
  assign media = product.media
-%}

{{ 'pravas-product.css' | asset_url | stylesheet_tag }}

<section class="pw-pdp" id="pw-pdp" data-section-id="{{ section.id }}">
  <div class="pw-pdp__inner">

    <!-- GALLERY -->
    <div class="pw-pdp__gallery" id="pw-pdp-gallery">
      <div class="pw-pdp__gallery-main">
        {%- if media.size > 0 -%}
          {%- for m in media -%}
            <div class="pw-pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ m.id }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m | media_tag }}
              {%- else -%}
                {{ m | image_url: width: 1400 | image_tag:
                     alt: m.alt | default: product.title,
                     class: 'pw-pdp__gallery-img',
                     loading: forloop.first | default: 'lazy',
                     widths: '700,1000,1400'
                }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="pw-pdp__gallery-ph">No product image</div>
        {%- endif -%}
        {% if section.settings.enable_zoom %}
          <button type="button" class="pw-pdp__zoom-btn" id="pw-pdp-zoom-btn" aria-label="View full screen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        {% endif %}
      </div>

      {%- if media.size > 1 -%}
        <div class="pw-pdp__gallery-grid">
          {%- for m in media -%}
            <button type="button" class="pw-pdp__gallery-thumb{% if forloop.first %} is-active{% endif %}" data-media-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m.preview_image | image_url: width: 400 | image_tag: alt: m.alt | default: product.title, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy' }}
              {%- else -%}
                {{ m | image_url: width: 400 | image_tag: alt: m.alt | default: product.title, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy' }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO PANEL -->
    <div class="pw-pdp__info">
      <span class="pw-pdp__eyebrow">{{ section.settings.eyebrow | default: 'THE FIRST CHAPTER' }}</span>
      <h1 class="pw-pdp__title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="pw-pdp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pw-pdp__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="pw-pdp__feature" {{ block.shopify_attributes }}>
                {%- if block.settings.icon -%}
                  <img src="{{ block.settings.icon | image_url: width: 48 }}" alt="" class="pw-pdp__feature-icon" loading="lazy" width="20" height="20">
                {%- else -%}
                  <svg class="pw-pdp__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endif -%}
                <span class="pw-pdp__feature-label">{{ block.settings.label }}</span>
                {%- if block.settings.value != blank -%}<span class="pw-pdp__feature-value">{{ block.settings.value }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'pw-pdp-form', class: 'pw-pdp__form' -%}
        <input type="hidden" name="id" id="pw-pdp-variant-id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            <div class="pw-pdp__option" data-option-index="{{ option_index }}">
              <span class="pw-pdp__option-label">
                {{ option.name }}: <span class="pw-pdp__option-selected" data-option-selected>{{ option.selected_value }}</span>
              </span>
              <div class="pw-pdp__swatches">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_bg = ''
                    assign swatch_fg = ''
                    assign value_key = value | downcase | strip
                    for sb in section.blocks
                      if sb.type == 'swatch_color'
                        assign sb_key = sb.settings.option_value | downcase | strip
                        if sb_key != '' and sb_key == value_key
                          assign swatch_bg = sb.settings.color
                          assign swatch_fg = sb.settings.text_color
                        endif
                      endif
                    endfor
                    if swatch_bg == blank and value.swatch.color
                      assign swatch_bg = value.swatch.color
                    endif
                  -%}
                  <button
                    type="button"
                    class="pw-pdp__swatch{% if value == option.selected_value %} is-active{% endif %}"
                    data-option-index="{{ option_index }}"
                    data-option-value="{{ value | escape }}"
                    {%- if swatch_bg != blank or swatch_fg != blank %} style="{% if swatch_bg != blank %}background:{{ swatch_bg }};{% endif %}{% if swatch_fg != blank %}--product-swatch-label-color:{{ swatch_fg }};{% endif %}"{% endif -%}
                  >
                    <span class="pw-pdp__swatch-label">{{ value }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pw-pdp__availability" id="pw-pdp-availability" data-threshold="{{ section.settings.low_stock_threshold | default: 15 }}">
          {%- if current_variant.inventory_management == 'shopify' -%}
            <span class="pw-pdp__availability-label">{{ section.settings.availability_label | default: 'FIRST BATCH AVAILABILITY' }}</span>
            <span class="pw-pdp__availability-count" id="pw-pdp-availability-count">{{ current_variant.inventory_quantity }} {{ section.settings.units_left_label | default: 'UNITS LEFT' }}</span>
          {%- endif -%}
        </div>

        <div class="pw-pdp__price" id="pw-pdp-price">
          <span class="pw-pdp__price-current" id="pw-pdp-price-current">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare" hidden></span>
          {%- endif -%}
        </div>

        <button
          type="submit"
          name="add"
          class="pw-pdp__atc"
          id="pw-pdp-atc"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="pw-pdp__atc-text">
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
            {%- else -%}
              {{ section.settings.sold_out_label | default: 'SOLD OUT' }}
            {%- endif -%}
          </span>
        </button>

        {%- if section.settings.reassurance != blank -%}
          <p class="pw-pdp__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>

  <!-- Full variant data for client-side switching (real Shopify data, no hardcoding) -->
  <script type="application/json" id="pw-pdp-variants-json">
    {{ product.variants | json }}
  </script>
  <script type="application/json" id="pw-pdp-media-json">
    [{% for m in media %}{"id":{{ m.id | json }},"index":{{ forloop.index0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>
  <script>window.pravasMoneyFormat = {{ shop.money_format | json }};</script>
</section>

<!-- STICKY ADD-TO-CART BAR -->
{% if section.settings.enable_sticky_bar %}
  <div class="pw-pdp-sticky" id="pw-pdp-sticky">
    <div class="pw-pdp-sticky__inner">
      <div class="pw-pdp-sticky__info">
        <span class="pw-pdp-sticky__eyebrow">{{ section.settings.sticky_eyebrow | default: 'CURRENTLY VIEWING' }}</span>
        <span class="pw-pdp-sticky__title">{{ product.title }} <span id="pw-pdp-sticky-variant">{% unless product.has_only_default_variant %}— {{ current_variant.title }}{% endunless %}</span></span>
      </div>
      <span class="pw-pdp-sticky__price" id="pw-pdp-sticky-price">{{ current_variant.price | money }}</span>
      <button type="button" class="pw-pdp-sticky__btn" id="pw-pdp-sticky-atc">
        {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
      </button>
    </div>
  </div>
{% endif %}

<style>
  #pw-pdp, #pw-pdp-sticky {
    --product-page-bg: {{ section.settings.color_bg | default: '#181818' }};
    --product-text: {{ section.settings.color_text | default: '#F5F3EF' }};
    --product-muted: {{ section.settings.color_muted | default: '#888888' }};
    --product-accent: {{ section.settings.color_accent | default: '#B5924A' }};
    --product-border: {{ section.settings.color_border | default: '#2E2E2E' }};

    --product-panel-bg: {{ section.settings.color_panel_bg | default: '#F5F3EF' }};
    --product-panel-text: {{ section.settings.color_panel_text | default: '#181818' }};
    --product-panel-muted: {{ section.settings.color_panel_muted | default: '#3A3A3A' }};

    --product-heading-font: var(--font-display);
    --product-heading-size: {{ section.settings.title_size_desktop | default: 40 }}px;
    --product-heading-size-mobile: {{ section.settings.title_size_mobile | default: 30 }}px;
    --product-heading-weight: {{ section.settings.title_weight | default: '400' }};
    --product-heading-line-height: {{ section.settings.title_line_height | default: 1.1 }};

    --product-eyebrow-color: {{ section.settings.color_eyebrow | default: '#B5924A' }};

    --product-button-bg: {{ section.settings.atc_bg | default: '#B5924A' }};
    --product-button-text: {{ section.settings.atc_text_color | default: '#181818' }};
    --product-button-border-color: {{ section.settings.atc_border_color | default: '#B5924A' }};
    --product-button-border-width: {{ section.settings.atc_border_width | default: 0 }}px;
    --product-button-radius: {{ section.settings.atc_radius | default: 0 }}px;

    --product-swatch-size: {{ section.settings.swatch_size | default: 40 }}px;
    --product-swatch-radius: {{ section.settings.swatch_radius | default: 0 }}px;
    --product-swatch-border: {{ section.settings.swatch_border_color | default: '#C8C8CC' }};
    --product-swatch-border-selected: {{ section.settings.swatch_border_selected_color | default: '#B5924A' }};
    --product-swatch-border-width: {{ section.settings.swatch_border_width | default: 1 }}px;

    --product-gallery-gap: {{ section.settings.gallery_gap | default: 12 }}px;
    --product-gallery-radius: {{ section.settings.gallery_radius | default: 0 }}px;
    --product-gallery-aspect: {{ section.settings.gallery_aspect_ratio | default: '1/1' }};
    --product-image-fit: {{ section.settings.image_fit | default: 'contain' }};
    --product-gallery-bg: {{ section.settings.gallery_bg | default: '#101010' }};
    --product-gallery-padding: {{ section.settings.gallery_padding | default: 0 }}px;
    --product-thumb-columns: {{ section.settings.thumb_columns | default: 3 }};
    --product-thumb-columns-mobile: {{ section.settings.thumb_columns_mobile | default: 3 }};
    --product-thumb-aspect: {{ section.settings.thumb_aspect_ratio | default: '1/1' }};
    --product-section-padding: {{ section.settings.padding_top | default: 0 }}px {{ section.settings.padding_x | default: 80 }}px {{ section.settings.padding_bottom | default: 0 }}px;
    --product-content-max-width: {{ section.settings.content_max_width | default: 1440 }}px;

    --product-availability-color: {{ section.settings.availability_color | default: '#3A3A3A' }};
    --product-price-color: {{ section.settings.price_color | default: '#181818' }};
    --product-price-compare-color: {{ section.settings.price_compare_color | default: '#888888' }};

    --sticky-bg: {{ section.settings.sticky_bg | default: '#F5F3EF' }};
    --sticky-text: {{ section.settings.sticky_text_color | default: '#181818' }};
    --sticky-price: {{ section.settings.sticky_price_color | default: '#181818' }};
  }
</style>

<script src="{{ 'pravas-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "PW Product Main",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE FIRST CHAPTER" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle quote (below title)", "default": "A testament to time and its measured movement. Designed in India, driven by Miyota." },
    { "type": "text", "id": "atc_label", "label": "Add to cart button text", "default": "ADD TO COLLECTION" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out button text", "default": "SOLD OUT" },
    { "type": "textarea", "id": "reassurance", "label": "Reassurance text (below button)", "default": "Ships within 24–48 hours." },
    { "type": "text", "id": "availability_label", "label": "Availability label", "default": "FIRST BATCH AVAILABILITY" },
    { "type": "text", "id": "units_left_label", "label": "Units-left label", "default": "UNITS LEFT" },
    { "type": "range", "id": "low_stock_threshold", "label": "Low-stock highlight threshold", "min": 0, "max": 100, "step": 5, "default": 15 },

    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "enable_zoom", "label": "Enable fullscreen zoom on click", "default": true },
    { "type": "range", "id": "gallery_gap", "label": "Gallery gap", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gallery_radius", "label": "Gallery image radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "info": "Fit shows the whole image inside the frame. Fill crops it.", "options": [{ "value": "contain", "label": "Fit (no crop)" }, { "value": "cover", "label": "Fill (crops)" }], "default": "contain" },
    { "type": "color", "id": "gallery_bg", "label": "Image frame background", "default": "#101010" },
    { "type": "range", "id": "gallery_padding", "label": "Image frame inner padding", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "gallery_aspect_ratio", "label": "Main image aspect ratio", "options": [{ "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait 4:5" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "3/2", "label": "Landscape 3:2" }, { "value": "16/9", "label": "Landscape 16:9" }], "default": "4/5" },
    { "type": "range", "id": "thumb_columns", "label": "Thumbnail columns — desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "thumb_columns_mobile", "label": "Thumbnail columns — mobile", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "thumb_aspect_ratio", "label": "Thumbnail aspect ratio", "options": [{ "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "3/2", "label": "Landscape 3:2" }, { "value": "4/5", "label": "Portrait 4:5" }], "default": "1/1" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max-width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "padding_top", "label": "Padding — top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding — bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_x", "label": "Padding — sides (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "title_size_desktop", "label": "Title size — desktop", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size — mobile", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "title_weight", "label": "Title weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }], "default": "400" },
    { "type": "range", "id": "title_line_height", "label": "Title line height", "min": 0.9, "max": 1.4, "step": 0.1, "default": 1.1 },

    { "type": "header", "content": "Colors — Page" },
    { "type": "color", "id": "color_bg", "label": "Gallery side background", "default": "#181818" },
    { "type": "color", "id": "color_text", "label": "Gallery side text", "default": "#F5F3EF" },
    { "type": "color", "id": "color_muted", "label": "Gallery side muted text", "default": "#888888" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#B5924A" },
    { "type": "color", "id": "color_border", "label": "Borders", "default": "#2E2E2E" },

    { "type": "header", "content": "Colors — Info Panel" },
    { "type": "color", "id": "color_panel_bg", "label": "Panel background", "default": "#F5F3EF" },
    { "type": "color", "id": "color_panel_text", "label": "Panel text", "default": "#181818" },
    { "type": "color", "id": "color_panel_muted", "label": "Panel muted text", "default": "#3A3A3A" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow", "default": "#B5924A" },
    { "type": "color", "id": "availability_color", "label": "Availability text", "default": "#3A3A3A" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#181818" },
    { "type": "color", "id": "price_compare_color", "label": "Compare-at price", "default": "#888888" },

    { "type": "header", "content": "Swatches" },
    { "type": "range", "id": "swatch_size", "label": "Swatch size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "swatch_radius", "label": "Swatch radius (0 = square)", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "swatch_border_width", "label": "Swatch border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "swatch_border_color", "label": "Swatch border", "default": "#C8C8CC" },
    { "type": "color", "id": "swatch_border_selected_color", "label": "Swatch border — selected", "default": "#B5924A" },

    { "type": "header", "content": "Add to Cart Button" },
    { "type": "color", "id": "atc_bg", "label": "Background", "default": "#B5924A" },
    { "type": "color", "id": "atc_text_color", "label": "Text", "default": "#181818" },
    { "type": "color", "id": "atc_border_color", "label": "Border", "default": "#B5924A" },
    { "type": "range", "id": "atc_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "atc_radius", "label": "Radius (0 = sharp)", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Sticky Add-to-Cart Bar" },
    { "type": "checkbox", "id": "enable_sticky_bar", "label": "Enable sticky bar", "default": true },
    { "type": "text", "id": "sticky_eyebrow", "label": "Sticky bar eyebrow", "default": "CURRENTLY VIEWING" },
    { "type": "color", "id": "sticky_bg", "label": "Background", "default": "#F5F3EF" },
    { "type": "color", "id": "sticky_text_color", "label": "Text", "default": "#181818" },
    { "type": "color", "id": "sticky_price_color", "label": "Price", "default": "#181818" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Movement" },
        { "type": "text", "id": "value", "label": "Value (optional)", "default": "Miyota 8215" }
      ]
    },
    {
      "type": "swatch_color",
      "name": "Swatch Colour",
      "settings": [
        { "type": "paragraph", "content": "Type the option value exactly as it appears on the product (e.g. Midnight Black), then pick the colour to show for it." },
        { "type": "text", "id": "option_value", "label": "Option value", "default": "Midnight Black" },
        { "type": "color", "id": "color", "label": "Swatch colour", "default": "#181818" },
        { "type": "color", "id": "text_color", "label": "Label colour on this swatch", "default": "#F5F3EF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW Product Main",
      "blocks": [
        { "type": "feature", "settings": { "label": "MOVEMENT", "value": "MIYOTA 8215" } },
        { "type": "feature", "settings": { "label": "SAPPHIRE" } },
        { "type": "feature", "settings": { "label": "FREE DELIVERY" } }
      ]
    }
  ]
}
{% endschema %}
