<section class="pw-feat" id="pw-feat">

  <div class="pw-feat__head">
    <span class="pw-eyebrow pw-feat__eyebrow">{{ section.settings.eyebrow | default: 'LAUNCH COLLECTION · TWO COLOURWAYS' }}</span>
    <h2 class="pw-feat__h2">
      <em>{{ section.settings.h2_italic | default: 'Sapphire Green' }}</em>
      <span class="pw-feat__vs"> {{ section.settings.h2_connector | default: 'vs' }} </span>
      <span>{{ section.settings.h2_plain | default: 'Midnight Black' }}</span>
    </h2>
  </div>

  <!-- Drag-to-compare slider: base layer (Sapphire Green) sits underneath,
       overlay layer (Midnight Black) is clipped to reveal the base layer
       as the handle is dragged. Vanilla JS in pravas.js drives the clip. -->
  <div class="pw-feat__compare" id="pw-feat-compare">

    <div class="pw-feat__compare-layer pw-feat__compare-layer--base">
      <span class="pw-feat__label pw-feat__label--left">{{ section.settings.label_green | default: 'Sapphire Green' }}</span>
      {% if section.settings.img_green %}
        {%- assign alt_green_txt = section.settings.alt_green | default: 'PRAVAS AARAMBH Sapphire Green' -%}
        {{ section.settings.img_green | image_url: width: 1400 | image_tag:
             alt: alt_green_txt,
             class: 'pw-feat__compare-img',
             loading: 'lazy',
             widths: '700,1000,1400'
        }}
      {% else %}
        <div class="pw-feat__ph">Upload Sapphire Green image</div>
      {% endif %}
    </div>

    <div class="pw-feat__compare-layer pw-feat__compare-layer--overlay" id="pw-feat-overlay">
      <span class="pw-feat__label pw-feat__label--right">{{ section.settings.label_black | default: 'Midnight Black' }}</span>
      {% if section.settings.img_black %}
        {%- assign alt_black_txt = section.settings.alt_black | default: 'PRAVAS AARAMBH Midnight Black' -%}
        {{ section.settings.img_black | image_url: width: 1400 | image_tag:
             alt: alt_black_txt,
             class: 'pw-feat__compare-img',
             loading: 'lazy',
             widths: '700,1000,1400'
        }}
      {% else %}
        <div class="pw-feat__ph">Upload Midnight Black image</div>
      {% endif %}
    </div>

    <div class="pw-feat__compare-divider" id="pw-feat-divider" aria-hidden="true"></div>

    <button
      type="button"
      class="pw-feat__compare-handle"
      id="pw-feat-handle"
      aria-label="Drag to compare Sapphire Green and Midnight Black"
      role="slider"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="7 8 3 12 7 16"/>
        <polyline points="17 8 21 12 17 16"/>
      </svg>
    </button>

  </div>

  <div class="pw-feat__foot">
    <p class="pw-feat__meaning">{{ section.settings.meaning | default: 'The Beginning — in two expressions.' }}</p>
    <p class="pw-feat__pricing">{{ section.settings.pricing | default: '₹8,499 · 50 pieces each colourway · Individually numbered.' }}</p>
    <a href="{{ section.settings.cta_url | default: '/products/pravas-aarambh' }}"
       class="btn btn--gold" style="display:inline-block; margin-top:24px;">
      {{ section.settings.cta_text | default: 'EXPLORE AARAMBH →' }}
    </a>
  </div>

</section>

<style>
  #pw-feat {
    --feat-bg: {{ section.settings.bg_color | default: '#181818' }};
    --feat-eyebrow: {{ section.settings.eyebrow_color | default: '#B5924A' }};
    --feat-heading: {{ section.settings.heading_color | default: '#F5F3EF' }};
    --feat-divider: {{ section.settings.divider_color | default: '#B5924A' }};
    --feat-handle-bg: {{ section.settings.handle_color | default: '#B5924A' }};
    --feat-handle-icon: {{ section.settings.handle_icon_color | default: '#181818' }};
    --feat-label-bg: {{ section.settings.label_bg_color | default: 'rgba(24,24,24,0.65)' }};
    --feat-label-text: {{ section.settings.label_text_color | default: '#F5F3EF' }};
    --feat-compare-height: {{ section.settings.compare_height | default: 600 }}px;
    --feat-compare-height-mobile: {{ section.settings.compare_height_mobile | default: 380 }}px;
  }
</style>

{% schema %}
{
  "name": "PW Colourways",
  "settings": [
    { "type": "header",       "content": "Content" },
    { "type": "text",         "id": "eyebrow",    "label": "Eyebrow",              "default": "LAUNCH COLLECTION · TWO COLOURWAYS" },
    { "type": "text",         "id": "h2_italic",  "label": "Heading — italic part","default": "Sapphire Green" },
    { "type": "text",         "id": "h2_plain",   "label": "Heading — plain part", "default": "Midnight Black" },
    { "type": "text",         "id": "h2_connector","label": "Heading connector word", "default": "vs" },
    { "type": "image_picker", "id": "img_green",  "label": "Sapphire Green image (base layer)" },
    { "type": "text",         "id": "alt_green",  "label": "Green alt text",       "default": "PRAVAS AARAMBH Sapphire Green" },
    { "type": "text",         "id": "label_green","label": "Green corner label",   "default": "Sapphire Green" },
    { "type": "image_picker", "id": "img_black",  "label": "Midnight Black image (overlay layer)" },
    { "type": "text",         "id": "alt_black",  "label": "Black alt text",       "default": "PRAVAS AARAMBH Midnight Black" },
    { "type": "text",         "id": "label_black","label": "Black corner label",   "default": "Midnight Black" },
    { "type": "text",         "id": "meaning",    "label": "Italic meaning line",  "default": "The Beginning — in two expressions." },
    { "type": "text",         "id": "pricing",    "label": "Pricing line",         "default": "₹8,499 · 50 pieces each colourway · Individually numbered." },
    { "type": "text",         "id": "cta_text",   "label": "CTA button text",      "default": "EXPLORE AARAMBH →" },
    { "type": "url",          "id": "cta_url",    "label": "CTA URL" },

    { "type": "header", "content": "Slider" },
    { "type": "range", "id": "compare_height", "label": "Slider height (desktop)", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 600 },
    { "type": "range", "id": "compare_height_mobile", "label": "Slider height (mobile)", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 380 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color",         "label": "Section background",     "default": "#181818" },
    { "type": "color", "id": "eyebrow_color",    "label": "Eyebrow color",          "default": "#B5924A" },
    { "type": "color", "id": "heading_color",    "label": "Heading color",          "default": "#F5F3EF" },
    { "type": "color", "id": "divider_color",    "label": "Divider line color",     "default": "#B5924A" },
    { "type": "color", "id": "handle_color",     "label": "Drag handle background", "default": "#B5924A" },
    { "type": "color", "id": "handle_icon_color","label": "Drag handle icon",       "default": "#181818" },
    { "type": "color", "id": "label_bg_color",   "label": "Corner label background","default": "#181818" },
    { "type": "color", "id": "label_text_color", "label": "Corner label text",      "default": "#F5F3EF" }
  ],
  "presets": [{ "name": "PW Colourways" }]
}
{% endschema %}
