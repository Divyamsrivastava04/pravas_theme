<section class="pw-feat">

  <div class="pw-feat__head">
    <span class="pw-eyebrow pw-feat__eyebrow">{{ section.settings.eyebrow | default: 'LAUNCH COLLECTION · TWO COLOURWAYS' }}</span>
    <h2 class="pw-feat__h2">
      <em>{{ section.settings.h2_italic | default: 'Sapphire Green' }}</em>
      <span class="pw-feat__vs"> {{ section.settings.h2_connector | default: 'vs' }} </span>
      <span>{{ section.settings.h2_plain | default: 'Midnight Black' }}</span>
    </h2>
  </div>

  <div class="pw-feat__split">

    <div class="pw-feat__half">
      <span class="pw-feat__label pw-feat__label--left">{{ section.settings.label_green | default: 'Sapphire Green' }}</span>
      {% if section.settings.img_green %}
        {{ section.settings.img_green | image_url: width: 1000 | image_tag:
             alt: section.settings.alt_green | default: 'PRAVAS AARAMBH Sapphire Green',
             class: 'pw-feat__img',
             loading: 'lazy',
             widths: '500,750,1000'
        }}
      {% else %}
        <div class="pw-feat__ph">Upload Sapphire Green image</div>
      {% endif %}
    </div>

    <div class="pw-feat__divider" aria-hidden="true"></div>

    <div class="pw-feat__half">
      <span class="pw-feat__label pw-feat__label--right">{{ section.settings.label_black | default: 'Midnight Black' }}</span>
      {% if section.settings.img_black %}
        {{ section.settings.img_black | image_url: width: 1000 | image_tag:
             alt: section.settings.alt_black | default: 'PRAVAS AARAMBH Midnight Black',
             class: 'pw-feat__img',
             loading: 'lazy',
             widths: '500,750,1000'
        }}
      {% else %}
        <div class="pw-feat__ph">Upload Midnight Black image</div>
      {% endif %}
    </div>

  </div>

  <div class="pw-feat__foot">
    <p class="pw-feat__meaning">{{ section.settings.meaning | default: 'The Beginning — in two expressions.' }}</p>
    <p class="pw-feat__pricing">{{ section.settings.pricing | default: '₹8,499 · 50 pieces each colourway · Individually numbered.' }}</p>
    <a href="{{ section.settings.cta_url | default: '/products/pravas-aarambh' }}"
       class="btn btn--gold" style="display:inline-block; margin-top:24px;">
      {{ section.settings.cta_text | default: 'EXPLORE AARAMBH →' }}
    </a>
  </div>

</section>

{% schema %}
{
  "name": "PW Featured Colourways",
  "settings": [
    { "type": "text",         "id": "eyebrow",    "label": "Eyebrow",              "default": "LAUNCH COLLECTION · TWO COLOURWAYS" },
    { "type": "text",         "id": "h2_italic",  "label": "Heading — italic part","default": "Sapphire Green" },
    { "type": "text",         "id": "h2_plain",   "label": "Heading — plain part", "default": "Midnight Black" },
    { "type": "text",         "id": "h2_connector","label": "Heading connector word", "default": "vs" },
    { "type": "image_picker", "id": "img_green",  "label": "Sapphire Green image" },
    { "type": "text",         "id": "alt_green",  "label": "Green alt text",       "default": "PRAVAS AARAMBH Sapphire Green" },
    { "type": "text",         "id": "label_green","label": "Green corner label",   "default": "Sapphire Green" },
    { "type": "image_picker", "id": "img_black",  "label": "Midnight Black image" },
    { "type": "text",         "id": "alt_black",  "label": "Black alt text",       "default": "PRAVAS AARAMBH Midnight Black" },
    { "type": "text",         "id": "label_black","label": "Black corner label",   "default": "Midnight Black" },
    { "type": "text",         "id": "meaning",    "label": "Italic meaning line",  "default": "The Beginning — in two expressions." },
    { "type": "text",         "id": "pricing",    "label": "Pricing line",         "default": "₹8,499 · 50 pieces each colourway · Individually numbered." },
    { "type": "text",         "id": "cta_text",   "label": "CTA button text",      "default": "EXPLORE AARAMBH →" },
    { "type": "url",          "id": "cta_url",    "label": "CTA URL",              "default": "/products/pravas-aarambh" }
  ],
  "presets": [{ "name": "PW Featured Colourways" }]
}
{% endschema %}
