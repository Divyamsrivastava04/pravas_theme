{{ 'pravas-product.css' | asset_url | stylesheet_tag }}
{{ 'pravas-accessory.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  PRAVAS accessory product hero.

  Deliberately emits the same .pw-pdp markup, ids and classes as the watch
  product page, so pravas-product.css, pravas-product.js and the swatch
  snippet all drive it unchanged — one variant picker, one add-to-cart path,
  one gallery, one sticky bar, one cart drawer. The watch template is not
  touched; this is a second consumer of the same components.

  The .pw-acc class is the only addition, and carries the simpler
  information hierarchy an accessory needs.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media = product.media
-%}

<section class="pw-pdp pw-acc" id="pw-pdp" data-section-id="{{ section.id }}" data-sold-out-label="{{ section.settings.sold_out_label | default: 'SOLD OUT' | escape }}">
  <div class="pw-pdp__inner">

    <!-- GALLERY -->
    <div class="pw-pdp__gallery" id="pw-pdp-gallery">
      <div class="pw-pdp__gallery-main">
        {%- if media.size > 0 -%}
          {%- for m in media -%}
            {%- liquid
              assign media_alt = m.alt | default: product.title
              assign media_loading = 'lazy'
              if forloop.first
                assign media_loading = 'eager'
              endif
            -%}
            <div class="pw-pdp__gallery-slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ m.id }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m | media_tag }}
              {%- elsif m.media_type == 'model' -%}
                {{ m | media_tag }}
              {%- else -%}
                {{ m | image_url: width: 1400 | image_tag: alt: media_alt, class: 'pw-pdp__gallery-img', loading: media_loading, sizes: '(min-width: 990px) 55vw, 100vw', widths: '500,700,1000,1400' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="pw-pdp__gallery-ph">No product image</div>
        {%- endif -%}
        {% if section.settings.enable_zoom and media.size > 0 %}
          <button type="button" class="pw-pdp__zoom-btn" id="pw-pdp-zoom-btn" aria-label="View full screen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        {% endif %}
      </div>

      {%- if media.size > 1 -%}
        <div class="pw-pdp__gallery-grid">
          {%- for m in media -%}
            {%- assign thumb_alt = m.alt | default: product.title -%}
            <button type="button" class="pw-pdp__gallery-thumb{% if forloop.first %} is-active{% endif %}" data-media-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m.preview_image | image_url: width: 600 | image_tag: alt: thumb_alt, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy', widths: '150,300,600' }}
              {%- else -%}
                {{ m | image_url: width: 600 | image_tag: alt: thumb_alt, class: 'pw-pdp__gallery-thumb-img', loading: 'lazy', widths: '150,300,600' }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO PANEL -->
    <div class="pw-pdp__info pw-acc__info">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pw-pdp__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="pw-pdp__title pw-acc__title">{{ product.title }}</h1>

      {%- if section.settings.show_description and product.description != blank -%}
        <div class="pw-acc__desc">{{ product.description }}</div>
      {%- endif -%}

      {%- if section.settings.show_sku and current_variant.sku != blank -%}
        <p class="pw-acc__sku" id="pw-acc-sku">
          <span class="pw-acc__sku-label">{{ section.settings.sku_label | default: 'SKU' }}</span>
          <span class="pw-acc__sku-value">{{ current_variant.sku }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.show_divider -%}<hr class="pw-acc__rule">{%- endif -%}

      {%- form 'product', product, id: 'pw-pdp-form', class: 'pw-pdp__form' -%}
        <input type="hidden" name="id" id="pw-pdp-variant-id" value="{{ current_variant.id }}">

        <div class="pw-pdp__price pw-acc__price" id="pw-pdp-price">
          <span class="pw-pdp__price-current" id="pw-pdp-price-current">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare">{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="pw-pdp__price-compare" id="pw-pdp-price-compare" hidden></span>
          {%- endif -%}
        </div>

        {%- comment -%}
          Options come straight from Shopify. A product with no real options
          renders no selector at all.
        {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            {%- liquid
              comment
                Same row-level decision as the watch page: if anything in the
                row has an image the whole row is a tile, so a row never mixes
                tall tiles with short colour blocks.
              endcomment
              assign row_mode = 'color'
              if section.settings.swatch_mode == 'image'
                assign row_mode = 'image'
              elsif section.settings.swatch_mode == 'auto'
                for value in option.values
                  assign scan_key = value | downcase | strip
                  for sb in section.blocks
                    if sb.type == 'swatch_color'
                      assign sb_key = sb.settings.option_value | downcase | strip
                      if sb_key == scan_key and sb.settings.image != blank
                        assign row_mode = 'image'
                      endif
                    endif
                  endfor
                  if value.swatch.image
                    assign row_mode = 'image'
                  endif
                  if section.settings.swatch_use_variant_image
                    for v in product.variants
                      if v.options[option_index] == value and v.image
                        assign row_mode = 'image'
                        break
                      endif
                    endfor
                  endif
                endfor
              endif
            -%}
            <div class="pw-pdp__option" data-option-index="{{ option_index }}">
              <span class="pw-pdp__option-label">
                {{ option.name }}: <span class="pw-pdp__option-selected" data-option-selected>{{ option.selected_value }}</span>
              </span>
              <div class="pw-pdp__swatches">
                {%- for value in option.values -%}
                  {%- liquid
                    assign swatch_bg = ''
                    assign swatch_fg = ''
                    assign swatch_img = ''
                    assign swatch_href = ''
                    assign swatch_attrs = ''
                    assign value_key = value | downcase | strip

                    for sb in section.blocks
                      if sb.type == 'swatch_color'
                        assign sb_key = sb.settings.option_value | downcase | strip
                        if sb_key != '' and sb_key == value_key
                          assign swatch_bg = sb.settings.color
                          assign swatch_fg = sb.settings.text_color
                          assign swatch_img = sb.settings.image
                          assign swatch_href = sb.settings.link_url
                          if sb.settings.link_product != blank
                            assign swatch_href = sb.settings.link_product.url
                          endif
                          assign swatch_attrs = sb.shopify_attributes
                        endif
                      endif
                    endfor

                    if swatch_bg == blank and value.swatch.color
                      assign swatch_bg = value.swatch.color
                    endif
                    if swatch_img == blank and value.swatch.image
                      assign swatch_img = value.swatch.image
                    endif
                    if swatch_img == blank and section.settings.swatch_use_variant_image
                      for v in product.variants
                        if v.options[option_index] == value and v.image
                          assign swatch_img = v.image
                          break
                        endif
                      endfor
                    endif

                    assign swatch_active = false
                    if value == option.selected_value
                      assign swatch_active = true
                    endif
                  -%}
                  {%- render 'pravas-product-swatch',
                    label: value,
                    image: swatch_img,
                    color: swatch_bg,
                    text_color: swatch_fg,
                    href: swatch_href,
                    option_index: option_index,
                    is_active: swatch_active,
                    mode: row_mode,
                    attrs: swatch_attrs
                  -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="pw-pdp__availability pw-acc__availability" id="pw-pdp-availability">
          {%- if current_variant.inventory_management == 'shopify' -%}
            <span class="pw-pdp__availability-label">{{ section.settings.availability_label | default: 'AVAILABILITY' }}</span>
            <span class="pw-pdp__availability-count" id="pw-pdp-availability-count">{{ current_variant.inventory_quantity }} {{ section.settings.units_left_label | default: 'IN STOCK' }}</span>
          {%- endif -%}
        </div>

        <button
          type="submit"
          name="add"
          class="pw-pdp__atc pw-acc__atc"
          id="pw-pdp-atc"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span class="pw-pdp__atc-text">
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
            {%- else -%}
              {{ section.settings.sold_out_label | default: 'SOLD OUT' }}
            {%- endif -%}
          </span>
        </button>

        {%- if section.settings.reassurance != blank -%}
          <p class="pw-pdp__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

  </div>

  <!-- Real Shopify variant data, read by pravas-product.js -->
  <script type="application/json" id="pw-pdp-variants-json">
    {{ product.variants | json }}
  </script>
  <script>window.pravasMoneyFormat = {{ shop.money_format | json }};</script>
</section>

{% if section.settings.enable_sticky_bar %}
  <div class="pw-pdp-sticky" id="pw-pdp-sticky">
    <div class="pw-pdp-sticky__inner">
      <div class="pw-pdp-sticky__info">
        <span class="pw-pdp-sticky__eyebrow">{{ section.settings.sticky_eyebrow | default: 'CURRENTLY VIEWING' }}</span>
        <span class="pw-pdp-sticky__title">{{ product.title }} <span id="pw-pdp-sticky-variant">{% unless product.has_only_default_variant %}— {{ current_variant.title }}{% endunless %}</span></span>
      </div>
      <span class="pw-pdp-sticky__price" id="pw-pdp-sticky-price">{{ current_variant.price | money }}</span>
      <button type="button" class="pw-pdp-sticky__btn" id="pw-pdp-sticky-atc">
        {{ section.settings.atc_label | default: 'ADD TO COLLECTION' }}
      </button>
    </div>
  </div>
{% endif %}

<script src="{{ 'pravas-product.js' | asset_url }}" defer="defer"></script>

<style>
  #pw-pdp {
    --product-page-bg: {{ section.settings.bg_color | default: '#181818' }};
    --product-text: {{ section.settings.text_color | default: '#F5F3EF' }};
    --product-muted: {{ section.settings.muted_color | default: '#8A8A8A' }};
    --product-accent: {{ section.settings.accent_color | default: '#B5924A' }};
    --product-eyebrow-color: {{ section.settings.eyebrow_color | default: '#B5924A' }};
    --product-panel-bg: {{ section.settings.panel_bg | default: '#F5F3EF' }};
    --product-panel-text: {{ section.settings.panel_text | default: '#181818' }};
    --product-panel-muted: {{ section.settings.panel_muted | default: '#3A3A3A' }};
    --product-content-max-width: {{ section.settings.content_max_width | default: 1440 }}px;
    --product-section-padding: 0 {{ section.settings.padding_x | default: 80 }}px;

    --product-gallery-gap: {{ section.settings.gallery_gap | default: 12 }}px;
    --product-gallery-radius: {{ section.settings.gallery_radius | default: 0 }}px;
    --product-gallery-aspect: {{ section.settings.gallery_aspect_ratio | default: '4/5' }};
    --product-gallery-bg: {{ section.settings.gallery_bg | default: '#101010' }};
    --product-gallery-padding: {{ section.settings.gallery_padding | default: 0 }}px;
    --product-image-fit: {{ section.settings.image_fit | default: 'contain' }};
    --product-image-position: {{ section.settings.image_position | default: 'center' }};
    --product-thumb-columns: {{ section.settings.thumb_columns | default: 4 }};

    --product-swatch-size: {{ section.settings.swatch_size | default: 40 }}px;
    --product-swatch-radius: {{ section.settings.swatch_radius | default: 0 }}px;
    --product-swatch-bg: {{ section.settings.swatch_bg_color | default: '#FFFFFF' }};
    --product-swatch-border: {{ section.settings.swatch_border_color | default: '#C8C8CC' }};
    --product-swatch-border-selected: {{ section.settings.swatch_border_selected_color | default: '#B5924A' }};
    --product-swatch-border-width: {{ section.settings.swatch_border_width | default: 1 }}px;
    --product-swatch-border-width-selected: {{ section.settings.swatch_border_width_selected | default: 2 }}px;
    --product-swatch-gap: {{ section.settings.swatch_gap | default: 10 }}px;
    --product-swatch-image-size: {{ section.settings.swatch_image_size | default: 72 }}px;
    --product-swatch-image-fit: {{ section.settings.swatch_image_fit | default: 'contain' }};
    --product-swatch-image-padding: 4px;
    --product-swatch-image-bg: {{ section.settings.swatch_image_bg | default: '#FFFFFF' }};
    --product-swatch-label-size: 10px;
    --product-swatch-label-gap: 8px;
    --product-swatch-label-list-color: {{ section.settings.panel_text | default: '#181818' }};
    --product-swatch-label-list-color-active: {{ section.settings.panel_text | default: '#181818' }};

    --product-button-bg: {{ section.settings.atc_bg | default: '#B5924A' }};
    --product-button-text: {{ section.settings.atc_text_color | default: '#181818' }};
    --product-button-border-color: {{ section.settings.atc_border_color | default: '#B5924A' }};
    --product-button-border-width: {{ section.settings.atc_border_width | default: 0 }}px;
    --product-button-radius: {{ section.settings.atc_radius | default: 0 }}px;

    --acc-gallery-width: {{ section.settings.gallery_width | default: 60 }}%;
    --acc-panel-width: {{ section.settings.panel_width | default: 40 }}%;
    --acc-panel-padding-y: {{ section.settings.panel_padding_y | default: 56 }}px;
    --acc-panel-padding-x: {{ section.settings.panel_padding_x | default: 56 }}px;
    --acc-stack-gap: {{ section.settings.info_gap | default: 18 }}px;
    --acc-title-size: {{ section.settings.title_size | default: 34 }}px;
    --acc-title-size-mobile: {{ section.settings.title_size_mobile | default: 24 }}px;
    --acc-desc-size: {{ section.settings.desc_size | default: 13 }}px;
    --acc-desc-line-height: {{ section.settings.desc_line_height | default: 1.8 }};
    --acc-price-size: {{ section.settings.price_size | default: 24 }}px;
    --acc-eyebrow-size: {{ section.settings.eyebrow_size | default: 9 }}px;
    --acc-divider-color: {{ section.settings.divider_color | default: '#C8C8CC' }};
    --acc-divider-width: {{ section.settings.divider_width | default: 1 }}px;
    --acc-btn-height: {{ section.settings.atc_height | default: 54 }}px;
    --acc-btn-size: {{ section.settings.atc_text_size | default: 11 }}px;
    --acc-btn-spacing: {{ section.settings.atc_letter_spacing | default: 2 }}px;
    --acc-duration: {{ section.settings.animation_duration | default: 300 }}ms;

    --acc-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --acc-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  }

  @media screen and (max-width: 989px) {
    #pw-pdp {
      --product-section-padding: 0 {{ section.settings.padding_x_mobile | default: 20 }}px;
      --acc-panel-padding-y: {{ section.settings.panel_padding_y_mobile | default: 32 }}px;
      --acc-panel-padding-x: {{ section.settings.panel_padding_x_mobile | default: 22 }}px;
      --acc-stack-gap: {{ section.settings.info_gap_mobile | default: 14 }}px;
      --product-gallery-gap: {{ section.settings.gallery_gap_mobile | default: 8 }}px;
      --product-thumb-columns: {{ section.settings.thumb_columns_mobile | default: 4 }};
    }
  }
</style>

{% schema %}
{
  "name": "PW Accessory Main",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ACCESSORIES" },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": true },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider above price", "default": true },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false },
    { "type": "text", "id": "sku_label", "label": "SKU label", "default": "SKU" },

    { "type": "header", "content": "Add to cart" },
    { "type": "text", "id": "atc_label", "label": "Button label", "default": "ADD TO COLLECTION" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "SOLD OUT" },
    { "type": "text", "id": "availability_label", "label": "Availability label", "default": "AVAILABILITY" },
    { "type": "text", "id": "units_left_label", "label": "Units left wording", "default": "IN STOCK" },
    { "type": "text", "id": "reassurance", "label": "Reassurance line", "default": "Free delivery across India" },
    { "type": "range", "id": "atc_height", "label": "Button height", "min": 36, "max": 80, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "atc_text_size", "label": "Button text size", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "atc_letter_spacing", "label": "Button letter spacing", "min": 0, "max": 6, "step": 0.5, "unit": "px", "default": 2 },
    { "type": "color", "id": "atc_bg", "label": "Button background", "default": "#B5924A" },
    { "type": "color", "id": "atc_text_color", "label": "Button text", "default": "#181818" },
    { "type": "color", "id": "atc_border_color", "label": "Button border", "default": "#B5924A" },
    { "type": "range", "id": "atc_border_width", "label": "Button border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "atc_radius", "label": "Button radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "gallery_width", "label": "Gallery width", "min": 30, "max": 75, "step": 1, "unit": "%", "default": 60 },
    { "type": "range", "id": "panel_width", "label": "Information panel width", "min": 25, "max": 70, "step": 1, "unit": "%", "default": 40 },
    { "type": "range", "id": "content_max_width", "label": "Content max-width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "padding_x", "label": "Padding sides — desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_x_mobile", "label": "Padding sides — mobile", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "panel_padding_y", "label": "Panel padding — vertical", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "panel_padding_x", "label": "Panel padding — horizontal", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "panel_padding_y_mobile", "label": "Panel padding — vertical, mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "panel_padding_x_mobile", "label": "Panel padding — horizontal, mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "info_gap", "label": "Space between info blocks", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "info_gap_mobile", "label": "Space between info blocks — mobile", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "enable_zoom", "label": "Enable full-screen zoom", "default": true },
    { "type": "select", "id": "gallery_aspect_ratio", "label": "Image ratio",
      "options": [
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Tall portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ], "default": "4/5" },
    { "type": "select", "id": "image_fit", "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Fit (whole image, never cropped)" },
        { "value": "cover", "label": "Fill (crops to the frame)" },
        { "value": "scale-down", "label": "Fit, never enlarge" }
      ], "default": "contain" },
    { "type": "select", "id": "image_position", "label": "Image position",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ], "default": "center" },
    { "type": "range", "id": "thumb_columns", "label": "Thumbnails per row — desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "thumb_columns_mobile", "label": "Thumbnails per row — mobile", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "gallery_gap", "label": "Gallery gap — desktop", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gallery_gap_mobile", "label": "Gallery gap — mobile", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "gallery_padding", "label": "Padding inside image frame", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "gallery_radius", "label": "Gallery corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "gallery_bg", "label": "Gallery background", "default": "#101010" },

    { "type": "header", "content": "Variant swatches" },
    { "type": "select", "id": "swatch_mode", "label": "Swatch style",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "image", "label": "Image with name below" },
        { "value": "color", "label": "Colour block" }
      ], "default": "auto" },
    { "type": "checkbox", "id": "swatch_use_variant_image", "label": "Use the variant's own photo when no swatch image is set", "default": true },
    { "type": "range", "id": "swatch_gap", "label": "Space between swatches", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "swatch_size", "label": "Colour block height", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 40 },
