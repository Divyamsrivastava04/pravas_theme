<section class="pw-contact">c</section>
{% schema %}
{
  "name": "PW Contact",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "header",
      "content": "Information Column"
    },
    {
      "type": "text",
      "id": "info_eyebrow",
      "label": "Column eyebrow",
      "default": "ATELIER DIRECTORY"
    },
    {
      "type": "text",
      "id": "info_location",
      "label": "Column location line",
      "info": "Leave blank if you do not want to show a location.",
      "default": ""
    },
    {
      "type": "header",
      "content": "Form — Content"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Form eyebrow",
      "default": "DIRECT INQUIRY"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Speak with PRAVAS."
    },
    {
      "type": "textarea",
      "id": "form_description",
      "label": "Form description",
      "default": "Please share your inquiry details below. Our concierge will review your message and respond personally."
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "FULL NAME"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "name@domain.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "PHONE NUMBER"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "Optional"
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Show inquiry subject dropdown",
      "default": true
    },
    {
      "type": "text",
      "id": "subject_label",
      "label": "Subject label",
      "default": "INQUIRY SUBJECT"
    },
    {
      "type": "textarea",
      "id": "subject_options",
      "label": "Subject options",
      "info": "Separate with a pipe ( | ).",
      "default": "Timepiece & Caliber Inquiry|Order & Delivery|Warranty & Service|Private Viewing|Other"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "YOUR MESSAGE / INQUIRY"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us how we can assist you…"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button text",
      "default": "SEND INQUIRY"
    },
    {
      "type": "checkbox",
      "id": "submit_show_arrow",
      "label": "Show arrow on button",
      "default": true
    },
    {
      "type": "text",
      "id": "form_note",
      "label": "Note below button",
      "info": "Leave blank to hide. Only state what your store actually offers.",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Our concierge will be in touch shortly."
    },
    {
      "type": "textarea",
      "id": "error_message",
      "label": "Error message",
      "default": "Please check the highlighted field and try again."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max-width",
      "min": 800,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1140
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Form field spacing",
      "min": 6,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "panel_padding",
      "label": "Form panel padding",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — desktop",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding sides — desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding sides — mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Form Panel"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Panel background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "Panel border",
      "default": "#2A2A2A"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel radius (0 = sharp)",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Inputs"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input background",
      "default": "#131313"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#F5F3EF"
    },
    {
      "type": "color",
      "id": "input_placeholder_color",
      "label": "Input placeholder",
      "default": "#6A6A6A"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#2E2E2E"
    },
    {
      "type": "color",
      "id": "input_focus_border_color",
      "label": "Input border — focus",
      "default": "#B5924A"
    },
    {
      "type": "range",
      "id": "input_border_width",
      "label": "Input border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Input radius (0 = sharp)",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "input_padding",
      "label": "Input padding",
      "min": 6,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#8A8A8A"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error",
      "default": "#C0564B"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success",
      "default": "#6E9E7E"
    },
    {
      "type": "header",
      "content": "Submit Button"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Background",
      "default": "#B5924A"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Text",
      "default": "#131313"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Hover background",
      "default": "#C7A25E"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Hover text",
      "default": "#131313"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Radius (0 = sharp)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "btn_padding",
      "label": "Button padding",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "btn_size",
      "label": "Font size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "form_heading_size",
      "label": "Form heading — desktop",
      "min": 16,
      "max": 52,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body / form font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#131313"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary text",
      "default": "#F5F3EF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#8A8A8A"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#B5924A"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#B5924A"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#2A2A2A"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact Detail",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this block",
          "default": true
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "CONCIERGE DESK"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        },
        {
          "type": "select",
          "id": "kind",
          "label": "Type",
          "info": "Email and Phone fall back to your Shopify store contact details when the value is left blank, and link automatically.",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "text",
              "label": "Plain text"
            }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Leave blank to use your Shopify store email/phone."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Custom link (optional)"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Small note below (optional)"
        }
      ]
    },
    {
      "type": "viewing",
      "name": "Private Viewing",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this block",
          "default": true
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "PRIVATE VIEWINGS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Private viewings are available by appointment."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "REQUEST A PRIVATE VIEWING"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "info": "Leave blank to jump to the form on this page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PW Contact",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "eyebrow": "CONCIERGE DESK",
            "kind": "email"
          }
        },
        {
          "type": "detail",
          "settings": {
            "eyebrow": "ORDERS & DELIVERY",
            "kind": "email",
            "description": "Questions regarding dispatch, transit, or order modifications."
          }
        },
        {
          "type": "detail",
          "settings": {
            "eyebrow": "WARRANTY & SERVICE",
            "kind": "email",
            "description": "Servicing, repairs, caliber maintenance and warranty enquiries."
          }
        },
        {
          "type": "viewing",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
