<section class="pw-phil">
  <div class="pw-phil__inner">
    <span class="pw-eyebrow pw-phil__eyebrow">{{ section.settings.eyebrow | default: 'OUR BELIEF' }}</span>
    <hr class="pw-phil__rule">
    <blockquote class="pw-phil__quote">{{ section.settings.quote | default: '"PRAVAS exists for those who decide to begin."' }}</blockquote>
    <p class="pw-phil__sub">{{ section.settings.subtext | default: "We don't sell time. We sell milestones." }}</p>
    <hr class="pw-phil__rule">
  </div>
</section>

{% schema %}
{
  "name": "PW Brand Philosophy",
  "settings": [
    { "type": "text",     "id": "eyebrow", "label": "Eyebrow",       "default": "OUR BELIEF" },
    { "type": "textarea", "id": "quote",   "label": "Pull quote (ends at 'begin.' — nothing after)", "default": "\"PRAVAS exists for those who decide to begin.\"" },
    { "type": "textarea", "id": "subtext", "label": "Subtext below",  "default": "We don't sell time. We sell milestones." }
  ],
  "presets": [{ "name": "PW Brand Philosophy" }]
}
{% endschema %}
