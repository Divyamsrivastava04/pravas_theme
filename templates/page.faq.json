          "settings": {
            "question": "What movement powers the PRAVAS Aarambh?",
            "answer": "<p>The Aarambh is powered by the Miyota 8215 automatic movement, a mechanical movement that winds itself through the natural motion of your wrist. It is designed to be worn, experienced, and maintained over time.</p>",
            "open_by_default": true
          }
        },
        "c1q2": {
          "type": "question",
          "settings": {
            "question": "Is the Aarambh a mechanical or quartz watch?",
