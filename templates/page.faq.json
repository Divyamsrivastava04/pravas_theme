            "open_by_default": false
          }
        },
        "c1q3": {
          "type": "question",
          "settings": {
            "question": "How much power reserve does the watch have?",
            "answer": "<p>The Aarambh has approximately 42 hours of power reserve.</p>",
            "open_by_default": false
          }
        },
        "c1q4": {
