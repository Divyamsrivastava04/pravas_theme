<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ settings.pw_page_title | default: 'PRAVAS Founding Owners' }}</title>
    <meta name="description" content="{{ settings.pw_meta_description | default: 'Become one of the first to own a PRAVAS watch. Apply for early access.' | escape }}">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <!-- Styles -->
    {{ 'pravas-password.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>
  <body class="pw-body">

    <!-- HEADER -->
    <header class="pw-header">
      <div class="pw-header__inner">
        <a href="{{ routes.root_url }}" class="pw-header__brand">
          <svg class="pw-mark pw-mark--sm" viewBox="0 0 48 64" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
            <circle cx="28" cy="24" r="18" stroke="currentColor" stroke-width="1.5"/>
            <line x1="24" y1="0" x2="24" y2="64" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="pw-header__wordmark">{{ settings.pw_brand_name | default: 'PRAVAS' }}</span>
        </a>
      </div>
    </header>

    <main id="MainContent">

      <!-- SECTION 1: HERO -->
      <section class="pw-hero">
        <div class="pw-hero__inner">

          <svg class="pw-mark pw-mark--hero" viewBox="0 0 48 64" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
            <circle cx="28" cy="24" r="18" stroke="currentColor" stroke-width="1.5"/>
            <line x1="24" y1="0" x2="24" y2="64" stroke="currentColor" stroke-width="1.5"/>
          </svg>

          <p class="pw-eyebrow pw-hero__eyebrow">
            {{ settings.pw_hero_eyebrow | default: 'PRAVAS WATCHES · AARAMBH' }}
          </p>

          <h1 class="pw-hero__h1">
            <span class="pw-hero__h1-line1">{{ settings.pw_hero_h1_line1 | default: 'PRAVAS' }}</span>
            <span class="pw-hero__h1-line2">{{ settings.pw_hero_h1_line2 | default: 'Founding Owners' }}</span>
          </h1>

          <hr class="pw-rule pw-hero__rule">

          <p class="pw-hero__subtext">
            {{ settings.pw_hero_subtext | default: 'The first chapter of PRAVAS will be written by a limited number of owners.' }}
          </p>

          <a href="#pw-form" class="pw-btn pw-hero__cta">
            {{ settings.pw_hero_cta | default: 'APPLY FOR EARLY ACCESS' }}
          </a>

          <p class="pw-hero__caption">
            {{ settings.pw_hero_caption | default: 'Become part of the first group of people who own one.' }}
          </p>

          <div class="pw-hero__scroll-arrow" aria-hidden="true">&darr;</div>

        </div>
      </section>

      <!-- SECTION 2: FOUNDING OWNERS -->
      <section class="pw-owners">
        <div class="pw-owners__inner">

          <div class="pw-owners__left">
            <h2 class="pw-owners__heading">
              {{ settings.pw_owners_heading | default: 'Not customers. Owners.' }}
            </h2>
            <p class="pw-owners__body">
              {{ settings.pw_owners_body | default: 'We are building a legacy, piece by piece. The Founding Owners will not just acquire a timepiece; they will become the bedrock of the PRAVAS story. This collection is engineered with precision, crafted with soul, and reserved for those who understand the weight of time.' }}
            </p>
          </div>

          <div class="pw-owners__right">

            <div class="pw-stat">
              <hr class="pw-stat__rule">
              <span class="pw-stat__number">{{ settings.pw_stat1_number | default: '100' }}</span>
              <span class="pw-stat__label">{{ settings.pw_stat1_label | default: 'PIECES' }}</span>
            </div>

            <div class="pw-stat">
              <hr class="pw-stat__rule">
              <span class="pw-stat__number">{{ settings.pw_stat2_number | default: '2' }}</span>
              <span class="pw-stat__label">{{ settings.pw_stat2_label | default: 'COLOURWAYS' }}</span>
            </div>

            <div class="pw-stat">
              <hr class="pw-stat__rule">
              <span class="pw-stat__number">{{ settings.pw_stat3_number | default: '0' }}</span>
              <span class="pw-stat__label">{{ settings.pw_stat3_label | default: 'COMPROMISES' }}</span>
            </div>

          </div>

        </div>
      </section>

      <!-- SECTION 3: THE WATCH -->
      <section class="pw-watch">
        <div class="pw-watch__inner">

          <div class="pw-watch__image-wrap">
            {%- if settings.pw_watch_image != blank -%}
              {{ settings.pw_watch_image | image_url: width: 800 | image_tag:
                   loading: 'lazy',
                   alt: settings.pw_watch_image_alt | default: 'PRAVAS AARAMBH movement',
                   class: 'pw-watch__image',
                   widths: '400,600,800'
              }}
            {%- else -%}
              <div class="pw-watch__image-placeholder">
                <span>Watch image</span>
              </div>
              <!-- [CLIENT TO CONFIRM: watch/movement photography not yet uploaded — set via Theme Settings → Password Page → Watch Section] -->
            {%- endif -%}
          </div>

          <div class="pw-watch__content">

            <p class="pw-eyebrow pw-watch__eyebrow">
              {{ settings.pw_watch_eyebrow | default: 'THE AARAMBH' }}
            </p>

            <h2 class="pw-watch__heading">
              {{ settings.pw_watch_heading | default: 'The Beginning' }}
            </h2>

            <div class="pw-specs">

              <div class="pw-spec-row">
                <span class="pw-spec-row__label">{{ settings.pw_spec1_label | default: 'MOVEMENT' }}</span>
                <span class="pw-spec-row__value">{{ settings.pw_spec1_value | default: 'Miyota 8215' }}</span>
              </div>

              <div class="pw-spec-row">
                <span class="pw-spec-row__label">{{ settings.pw_spec2_label | default: 'CASE' }}</span>
                <span class="pw-spec-row__value">{{ settings.pw_spec2_value | default: 'Stainless Steel' }}</span>
              </div>

              <div class="pw-spec-row">
                <span class="pw-spec-row__label">{{ settings.pw_spec3_label | default: 'DIAMETER' }}</span>
                <span class="pw-spec-row__value">{{ settings.pw_spec3_value | default: '38mm' }}</span>
              </div>

              <div class="pw-spec-row">
                <span class="pw-spec-row__label">{{ settings.pw_spec4_label | default: 'RESERVE' }}</span>
                <!-- Confirmed spec: Miyota 8215 power reserve is 42 hours, not 72 (the reference design image had this wrong). -->
                <span class="pw-spec-row__value">{{ settings.pw_spec4_value | default: '42 Hours' }}</span>
              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- SECTION 4: APPLICATION FORM -->
      <section class="pw-form-section" id="pw-form">
        <div class="pw-form-section__inner">

          <p class="pw-eyebrow pw-form-section__eyebrow">
            {{ settings.pw_form_eyebrow | default: 'APPLICATION' }}
          </p>

          <h2 class="pw-form-section__heading">
            {{ settings.pw_form_heading | default: 'Secure Your Position' }}
          </h2>

          <!--
            Native Shopify customer form. Shopify handles the POST, CSRF
            protection, and action/redirect automatically — submissions
            appear in Shopify's customer list tagged "founding-owner-waitlist".
            form.posted_successfully? / form.errors reflect the real result
            of the submission (no fake loading states).
          -->
          {%- form 'customer', id: 'pw-application-form', class: 'pw-form' -%}
            <input type="hidden" name="contact[tags]" value="founding-owner-waitlist">

            {%- if form.posted_successfully? -%}

              <div class="pw-form__success" id="pw-success" tabindex="-1" autofocus>
                <p>{{ settings.pw_success_message | default: 'Your access is on its way. We have your name. When the list opens, you will be among the first to know.' }}</p>
              </div>

            {%- else -%}

              <!-- Full Name -->
              <div class="pw-field">
                <label class="pw-field__label" for="pw-name">
                  {{ settings.pw_field1_label | default: 'FULL NAME' }}
                </label>
                <input
                  type="text"
                  id="pw-name"
                  name="contact[first_name]"
                  class="pw-field__input"
                  placeholder="{{ settings.pw_field1_placeholder | default: 'John Doe' }}"
                  required
                  autocomplete="name"
                >
              </div>

              <!-- Email -->
              <div class="pw-field{% if form.errors %} pw-field--error{% endif %}">
                <label class="pw-field__label" for="pw-email">
                  {{ settings.pw_field2_label | default: 'EMAIL ADDRESS' }}
                </label>
                <input
                  type="email"
                  id="pw-email"
                  name="contact[email]"
                  class="pw-field__input"
                  value="{{ form.email }}"
                  placeholder="{{ settings.pw_field2_placeholder | default: 'john@example.com' }}"
                  required
                  autocomplete="email"
                  {%- if form.errors %}
                    aria-invalid="true"
                    aria-describedby="pw-email-error"
                  {%- endif %}
                >
                {%- if form.errors -%}
                  <span class="pw-field__error" id="pw-email-error">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                {%- endif -%}
              </div>

              <!-- Country -->
              <div class="pw-field">
                <label class="pw-field__label" for="pw-country">
                  {{ settings.pw_field3_label | default: 'COUNTRY' }}
                </label>
                <input
                  type="text"
                  id="pw-country"
                  name="contact[note]"
                  class="pw-field__input"
                  placeholder="{{ settings.pw_field3_placeholder | default: 'India' }}"
                  autocomplete="country-name"
                >
              </div>

              <button type="submit" class="pw-btn pw-form__submit">
                {{ settings.pw_form_cta | default: 'SUBMIT APPLICATION' }}
              </button>

              <p class="pw-form__fine-print">
                {{ settings.pw_form_fine_print | default: 'Submitting this form registers your interest but does not guarantee an allocation.' }}
              </p>

            {%- endif -%}
          {%- endform -%}

        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="pw-footer">
      <div class="pw-footer__inner">

        <div class="pw-footer__brand">
          <svg class="pw-mark pw-mark--sm" viewBox="0 0 48 64" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
            <circle cx="28" cy="24" r="18" stroke="currentColor" stroke-width="1.5"/>
            <line x1="24" y1="0" x2="24" y2="64" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="pw-footer__wordmark">{{ settings.pw_brand_name | default: 'PRAVAS' }}</span>
        </div>

        <p class="pw-footer__copy">
          {{ settings.pw_footer_copy | default: '© 2025 Pravas Watches. ALL RIGHTS RESERVED.' }}
        </p>

        <nav class="pw-footer__links">
          <a href="{{ settings.pw_privacy_url | default: '/pages/privacy-policy' }}">
            {{ settings.pw_privacy_label | default: 'Privacy' }}
          </a>
          <a href="{{ settings.pw_terms_url | default: '/pages/terms-of-service' }}">
            {{ settings.pw_terms_label | default: 'Terms' }}
          </a>
          <a href="{{ settings.pw_contact_url | default: '/pages/contact' }}">
            {{ settings.pw_contact_label | default: 'Contact' }}
          </a>
        </nav>

      </div>
    </footer>

  </body>
</html>
